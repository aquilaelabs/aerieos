# The files every release of AerieOS carries, one a line, @VER@ the
# release's version (0.9.0, 0.9.0-dev.4501) and * as a shell pattern. The
# controller checks each release against the list at its own tag as its
# CI ends, and says on the bell what is missing and why, or that it is
# complete (releasefiles.py); the tag's last job publishes a dev build once
# it carries them all, and the release rehearsal says which were built
# (tools/release-missing.sh).
aerieos-controller-@VER@.tar.gz
aerieos-controller-@VER@.tar.gz.sha256
aerieos-companion-@VER@.exe
aerieos-companion-@VER@.exe.sha256
aerieos-usb-maker-@VER@.exe
aerieos-usb-maker-@VER@.exe.sha256
aerieos-companion-@VER@.pyz
aerieos-companion-@VER@.pyz.sha256
aerieos-vscode-@VER@.vsix
aerieos-vscode-@VER@.vsix.sha256
aerieos-app-@VER@.apk
aerieos-app-@VER@.apk.sha256
aerieos-os-@VER@.iso
aerieos-os-@VER@.iso.sha256
aerieos-os-@VER@.attestation.jsonl
aerieos-os-@VER@.stick.raw.xz
aerieos-os-@VER@.stick.raw.xz.sha256

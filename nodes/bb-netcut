#!/usr/bin/python3 -I
"""bb-netcut: run a command as the caller with no network.

A tool pack that declares its downloads has them fetched and held to their
sha256 by AerieOS, and its install steps then run with the network cut, so
nothing the manifest does not name arrives (scripts/lib/sdk.sh sdk_net_cut).
The cut is a network namespace of the step's own, which an account makes for
itself where the machine lets it. Where it does not (a distribution that
keeps user namespaces from unprivileged accounts), this makes it:

    sudo -n bb-netcut CMD [ARG...]

A new network namespace, holding nothing but a loopback that is down, and
a mount namespace of its own with an empty tmpfs only root may write over
/run (and over /var/run where that is a folder and not a link to it); then
the caller's own account again, for good, with its own group and none of
its others (no_new_privs); then CMD, told BB_NETCUT_RUN=covered. Nothing
else: no file, no option. A cut of the network alone leaves every socket
on the disk in reach: the system bus's and systemd-resolved's under /run,
which any account may write and which look names up past the cut, and,
in the docker group, the docker daemon's, which would make a container
with the network and the host's root. Where /run cannot be covered (a
machine that refuses the mount), CMD runs all the same, as it did before
there was a cover, and is not told it was: the installer counts its steps
as run with the network then (scripts/lib/sdk.sh sdk_net_cut).

Root, and the one thing the account a node's jobs run as may run through
sudo for it (the agent installs this and writes that rule). What it is
handed is run as the caller sudo names and never as root, so it gives that
account nothing but the loss of the network: the caller is read from sudo
alone, root is never a caller, and the environment CMD starts with is a
plain one of the caller's, whatever sudo kept.

The node's agent, where it is root, runs it too, with no sudo: for the
steps of a coding agent's install, which run as the session account, an
account that has no rule for this and is given none. The agent names that
account the way sudo names a caller (SUDO_UID), and the same holds: the
command runs as that account and never as root. Only root can say whom,
since only root gets this far without sudo saying it.
"""
import ctypes
import os
import pwd
import sys

CLONE_NEWNET = 0x40000000
CLONE_NEWNS = 0x00020000
PR_SET_NO_NEW_PRIVS = 38
MS_NOSUID, MS_NODEV, MS_NOEXEC, MS_REC, MS_PRIVATE = 0x2, 0x4, 0x8, 0x4000, 0x40000
PATH = "/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# What is covered, and whether each is a folder of its own there to cover.
RUN = ("/run", "/var/run")


def plan(argv, environ, euid):
    """(account, command, environment) for what was asked, or a sentence
    saying why not. The account is the passwd entry of the caller sudo names."""
    cmd = list(argv)
    if cmd[:1] == ["--"]:
        cmd = cmd[1:]
    if not cmd or cmd[0].startswith("-"):
        return "usage: sudo -n bb-netcut CMD [ARG...]: CMD is run as you, with no network"
    if euid != 0:
        return "bb-netcut makes a network namespace, which takes root: it is run through sudo"
    uid = str(environ.get("SUDO_UID") or "")
    if not uid.isdigit() or int(uid) == 0:
        return "bb-netcut runs a command as the account sudo names, and that is never root"
    try:
        who = pwd.getpwuid(int(uid))
    except KeyError:
        return f"bb-netcut: no account has the uid {uid}"
    env = {"PATH": PATH, "HOME": who.pw_dir, "USER": who.pw_name, "LOGNAME": who.pw_name,
           "SHELL": who.pw_shell or "/bin/sh", "LANG": "C.UTF-8"}
    return who, cmd, env


def _call(libc, name, *args):
    if getattr(libc, name)(*args) != 0:
        e = ctypes.get_errno()
        raise OSError(e, f"{name}: {os.strerror(e)}")


def cover_run(libc):
    """A mount namespace of this process's own, private, with an empty tmpfs
    over /run and over /var/run where that is a folder and not a link.
    Whether it held; what refused it is said on stderr."""
    try:
        _call(libc, "unshare", ctypes.c_int(CLONE_NEWNS))
        _call(libc, "mount", ctypes.c_char_p(b"none"), ctypes.c_char_p(b"/"), ctypes.c_char_p(None),
              ctypes.c_ulong(MS_REC | MS_PRIVATE), ctypes.c_char_p(None))
        for where in RUN:
            if where != RUN[0] and (os.path.islink(where) or not os.path.isdir(where)):
                continue
            _call(libc, "mount", ctypes.c_char_p(b"tmpfs"), ctypes.c_char_p(where.encode()), ctypes.c_char_p(b"tmpfs"),
                  ctypes.c_ulong(MS_NOSUID | MS_NODEV | MS_NOEXEC), ctypes.c_char_p(b"mode=0755,size=1m"))
    except OSError as e:
        print(f"bb-netcut: /run is left as it is ({e}): the step reaches the system's sockets", file=sys.stderr)
        return False
    return True


def main(argv):
    got = plan(argv, os.environ, os.geteuid())
    if isinstance(got, str):
        print(got, file=sys.stderr)
        return 64
    who, cmd, env = got
    libc = ctypes.CDLL(None, use_errno=True)
    try:
        _call(libc, "unshare", ctypes.c_int(CLONE_NEWNET))
        if cover_run(libc):
            env["BB_NETCUT_RUN"] = "covered"
        # The caller's own account again, for good, with no group but its own.
        os.setgroups([])
        os.setgid(who.pw_gid)
        os.setuid(who.pw_uid)
        _call(libc, "prctl", ctypes.c_int(PR_SET_NO_NEW_PRIVS), ctypes.c_ulong(1), ctypes.c_ulong(0),
              ctypes.c_ulong(0), ctypes.c_ulong(0))
    except OSError as e:
        print(f"bb-netcut: {e}", file=sys.stderr)
        return 71
    if os.getuid() != who.pw_uid or os.geteuid() != who.pw_uid or os.getgroups() not in ([], [who.pw_gid]):
        print("bb-netcut: the drop to the caller's account did not hold", file=sys.stderr)
        return 71
    try:
        os.execvpe(cmd[0], cmd, env)
    except OSError as e:
        print(f"bb-netcut: {cmd[0]}: {e}", file=sys.stderr)
        return 127
    return 127


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))

#!/bin/sh
# What the initramfs carries for AerieOS: losetup, for the slot loaded
# into RAM (scripts/local-top/aerieos-os-toram), od to read its size, and
# veritysetup with the device mapper's verity target, for the root opened
# through its hash tree (scripts/local-top/aerieos-os-verity).
PREREQ=""
prereqs() { echo "$PREREQ"; }
case "${1:-}" in prereqs) prereqs; exit 0 ;; esac
. /usr/share/initramfs-tools/hook-functions
copy_exec /sbin/losetup /sbin
copy_exec /usr/bin/od /bin
copy_exec /usr/sbin/veritysetup /sbin
manual_add_modules dm_mod
manual_add_modules dm_verity

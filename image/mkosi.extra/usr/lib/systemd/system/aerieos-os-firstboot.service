[Unit]
Description=AerieOS: this machine made its own controller's first node, once
# Once: install-controller.sh --firstboot writes the own-node marker when
# the node is enrolled, and the unit does not run again. The controller's
# service is the image's, enabled when it was built, so it is up first.
# Again where the agent is gone though the machine is enrolled, as a boot from
# before /usr/local lasted left it (B669): it provisions the node again, on the
# identity it has, and enrolls nothing new. Either condition is enough (|).
ConditionPathExists=|!/etc/aerieos-controller/own-node
ConditionPathExists=|!/usr/local/sbin/aerieos-agent
# Never under the ISO's installer, where no controller runs to enrol with
# and a root agent on the LAN is the last thing wanted (B475).
ConditionKernelCommandLine=!bbinstaller=1
After=network-online.target aerieos-controller.service
Wants=network-online.target aerieos-controller.service

[Service]
Type=oneshot
ExecStart=/opt/aerieos/nodes/install-controller.sh --firstboot
TimeoutStartSec=15min
StandardOutput=journal+console

[Install]
WantedBy=multi-user.target

#!/usr/bin/env bash
# The system pool of an AerieOS stick (R161 step 10, the operator,
# 29 Oct: the stick read once and written rarely, as Unraid's is): what
# writes all day, docker's and containerd's data, libvirt's, the toolchain
# store and the projects, lives on a pool, bound over its usual place at
# every boot, and the stick keeps the configuration alone. Until a pool is
# named, docker, containerd and libvirt are held (the initramfs's drop-ins
# wait for /run/aerieos-os/system-pool-ready), as Unraid's Docker and VMs
# wait for the array.
#
# The secrets folder (its *.env files, ssh/ and the install key) goes to the
# pool too (the operator, 7 Nov): the stick alone, lost or taken, then opens
# nothing the controller sealed. While a named pool is not mounted it is held
# empty and read only, so no key is made on the stick in the key's place.
#
#   system-pool apply        at boot (aerieos-os-system-pool.service), and
#                            again while the pool is not mounted yet: bind
#                            each folder, then let the held services start
#   system-pool set PATH     name the pool's mount point: the services
#                            stopped, what the stick holds of each moved to
#                            the pool, the name kept, applied, started again
#   system-pool status       one JSON line for the census
#   system-pool projects PATH [NAME...]
#                            name a folder already on the machine's disks
#                            (an adopted share that holds the projects) as
#                            the projects folder: bound over it at every
#                            boot in place of the pool's, its files handed
#                            to the controller's account, the controller
#                            restarted on it; the NAMEs are the projects the
#                            controller knows, each said found or missing
#   system-pool projects --release
#                            let it go: the pool's (or the stick's) again
#
# On a boot that is not a stick's (an installed disk), apply and status say
# so and change nothing: there the data partition is the machine's disk.
set -euo pipefail
WORK="${BB_OS_WORK:-/var/lib/aerieos-os}"
FILE="$WORK/system-pool"
RUN="${BB_OS_RUN:-/run/aerieos-os}"
READY="$RUN/system-pool-ready"
CMDLINE="${BB_CMDLINE:-/proc/cmdline}"
ENVF="${BB_CONTROLLER_ENV:-/etc/aerieos-controller/controller.env}"
SUB="aerieos-system"
SERVICES=(containerd docker libvirtd)
PFILE="$WORK/projects-folder"
# Which install a pool's folder is (the operator, 6 Nov): another install's
# data (its containers, VMs, toolchains, spaces and the session accounts'
# homes with their sign-ins) is never taken by a new one; that comes over only
# through a move token from the controller it was.
IDFILE="$WORK/install-id"
OWNER_MARK=".aerieos-install"
install_id() {
    if [ ! -s "$IDFILE" ]; then
        mkdir -p "$WORK"
        tr -d '-' < /proc/sys/kernel/random/uuid > "$IDFILE.new" && mv -f "$IDFILE.new" "$IDFILE"
    fi
    head -c 64 "$IDFILE"
}
# Whose a pool's folder is: "" when it holds nothing, "mine", or "other".
pool_owner() {
    local d="$1/$SUB" mark f held=""
    for f in "$d"/* "$d"/.[!.]* "$d"/..?*; do
        [ -e "$f" ] || [ -L "$f" ] || continue
        [ "${f##*/}" = "$OWNER_MARK" ] && continue
        held=1; break
    done
    [ -n "$held" ] || { echo ""; return 0; }
    mark="$(head -c 64 "$d/$OWNER_MARK" 2>/dev/null || true)"
    if [ -n "$mark" ] && [ "$mark" = "$(install_id)" ]; then echo mine; else echo other; fi
}
mark_pool() { mkdir -p "$1/$SUB" && install_id > "$1/$SUB/$OWNER_MARK"; }
# Where another install's folder goes when set aside: SUB.old, then
# SUB.old-2, -3 and on, never over one set aside before.
aside_name() {
    local n=1 d="$1/$SUB.old"
    while [ -e "$d" ] || [ -L "$d" ]; do n=$((n + 1)); d="$1/$SUB.old-$n"; done
    printf '%s' "$d"
}
# The mounted filesystems holding another install's folder, said before a
# pool is picked so the page can offer to set it aside.
others() {
    local t
    while IFS= read -r t; do
        case "$t" in /|/proc*|/sys*|/dev*|/run*|/boot*|/usr*|/etc*|/var*|/home*|/srv*|/tmp*) continue ;; esac
        if [ -d "$t/$SUB" ] && [ "$(pool_owner "$t")" = other ]; then printf '"%s"\n' "${t//\"/}"; fi
    done < <(findmnt -rn -o TARGET 2>/dev/null | sort -u)
    return 0
}
CONTROLLER="aerieos-controller"

envget() { sed -n "s/^$1=//p" "$ENVF" 2>/dev/null | tr -d '"' | tail -1; }
projects_place() { local ws; ws="$(envget WORKSPACE)"; printf '%s' "${ws:-/srv/aerieos/projects}"; }
# The folder named as the projects folder, if one is (projects PATH).
named_projects() { [ -s "$PFILE" ] && head -1 "$PFILE"; }
bound() { findmnt -rn -o TARGET "$1" 2>/dev/null | grep -qx "$1"; }
# The projects never on the stick (the operator, 1 Nov): until a system pool
# or a folder on the disks is named, the projects folder is an empty
# read-only mount of its own, held, so nothing can be written there.
HELD="bb-projects-held"
HELD_SECRETS="bb-secrets-held"
held() { findmnt -rn -o SOURCE "$1" 2>/dev/null | grep -qx -e "$HELD" -e "$HELD_SECRETS"; }
secrets_place() { printf '%s' "${BB_SP_SECRETS:-/etc/aerieos-controller/secrets}"; }
# The secrets held while the pool they live on is not mounted: an empty,
# read-only folder with a mark the controller's boot reads (lib/boot.sh
# secrets_held), so it makes no key and waits.
hold_secrets() {
    local place; place="$(secrets_place)"
    mkdir -p "$place"
    held "$place" && return 0
    # Secrets the stick still holds (a pool named by an earlier release,
    # not mounted yet to take them) are the controller's key: used, not hidden.
    [ -n "$(ls -A "$place" 2>/dev/null)" ] && return 0
    [ -n "${BB_SP_NO_MOUNT:-}" ] && return 0
    if mount -t tmpfs -o size=64k,mode=0700 "$HELD_SECRETS" "$place" 2>/dev/null; then
        : > "$place/.aerieos-held"
        mount -o remount,ro "$place" 2>/dev/null || true
        echo "system-pool: the secrets wait for the system pool: the controller seals and opens nothing until it mounts"
    else
        echo "system-pool: the secrets folder could not be held while the pool is not mounted" >&2
    fi
}
hold_projects() {
    local place; place="$(projects_place)"
    mkdir -p "$place"
    held "$place" && return 0
    bound "$place" && return 0
    if [ -z "${BB_SP_NO_MOUNT:-}" ] && ! mount -t tmpfs -o ro,size=64k,mode=0755 "$HELD" "$place" 2>/dev/null; then
        echo "system-pool: the spaces folder could not be held read only; the controller still makes no space until they have a place" >&2
        return 0
    fi
    echo "system-pool: the spaces are held: none is made on the stick, and they wait for a system pool or a folder on the disks"
}
# A folder made on a pool is as the place it is bound over is, whoever that is
# (the projects and the toolchains are the controller's, not root's, B597).
as_place() {
    [ -n "${BB_SP_NO_MOUNT:-}" ] && return 0
    chown --reference="$2" "$1" 2>/dev/null || true
    chmod --reference="$2" "$1" 2>/dev/null || true
}
# The pool's secrets folder shut as the folder it stands in for is: root's,
# nothing for anybody else, and for the controller's account the one way
# through to its own key folder where the folder it replaces had it (0710,
# boot.sh secrets_enterable, which only a controller's start sets). Shut
# outright here, a running controller was locked out of its key until its
# next start, and a move landed in that time, right after Moving here placed
# the pool, was refused at the install key it carried (B777).
secrets_shut() {
    local through=""
    [ -d "$2" ] && [ "$(( 0$(stat -c %a "$2" 2>/dev/null || echo 0) & 010 ))" -ne 0 ] && through=1
    [ -z "$through" ] || chgrp --reference="$2" "$1" 2>/dev/null || true
    chmod go-rwx "$1"
    [ -z "$through" ] || chmod g+x "$1"
}
# The hold let go before the projects get a real place.
unhold() { held "$1" && umount "$1"; return 0; }
# name=place, each a folder that writes all day; the projects only while no
# folder of the machine's own is named for them.
# The two the image itself binds from the data partition (init-bottom/aerieos-os).
lasting() { case "$1" in home|workspace) return 0 ;; esac; return 1; }
# Whether two paths are one folder: the same device and inode.
on_it() { [ "$(stat -c %d:%i "$1" 2>/dev/null)" = "$(stat -c %d:%i "$2" 2>/dev/null)" ]; }
targets() {
    local sdk
    sdk="$(envget SDK_ROOT)"
    printf '%s\n' "docker=${BB_SP_DOCKER:-/var/lib/docker}" "containerd=${BB_SP_CONTAINERD:-/var/lib/containerd}" \
        "libvirt=${BB_SP_LIBVIRT:-/var/lib/libvirt}" "toolchains=${sdk:-/var/lib/aerieos-controller/sdk}" \
        "home=${BB_SP_HOME:-/home}" "workspace=${BB_SP_WORKSPACE:-/workspace}" "secrets=$(secrets_place)"
    named_projects >/dev/null || printf '%s\n' "projects=$(projects_place)"
}

# The named projects folder bound over the controller's, at every boot and
# whenever it comes up late (an array put together after boot); the
# controller restarted when it was running on what lay underneath.
apply_projects() {
    local f place
    f="$(named_projects || true)"
    [ -n "$f" ] || return 0
    place="$(projects_place)"
    if [ ! -d "$f" ]; then
        # Held meanwhile: nothing written underneath where the disk will be.
        hold_projects
        echo "system-pool: the spaces folder $f is not there yet (its disks not mounted): tried again in half a minute" >&2
        return 1
    fi
    mkdir -p "$place"
    unhold "$place"
    if ! bound "$place"; then
        [ -n "${BB_SP_NO_MOUNT:-}" ] || mount --bind "$f" "$place"
        if [ -z "${BB_SP_NO_SYSTEMCTL:-}" ] && systemctl is-active --quiet "$CONTROLLER" 2>/dev/null; then
            systemctl restart --no-block "$CONTROLLER" 2>/dev/null || true
        fi
    fi
    echo "system-pool: the spaces are $f"
}
stick() { grep -qw 'aerietoram=1' "$CMDLINE" 2>/dev/null; }
mounted() { [ -n "${BB_SP_MOUNTED:-}" ] && { [ "$BB_SP_MOUNTED" = 1 ]; return; }; findmnt -rn --target "$1" -o TARGET 2>/dev/null | grep -qx "$1"; }
pool() { [ -s "$FILE" ] && head -1 "$FILE"; }
units() { for u in "${SERVICES[@]}"; do systemctl list-unit-files "$u.service" >/dev/null 2>&1 && printf '%s\n' "$u"; done; }

apply() {
    stick || { echo "system-pool: not a stick boot: the data partition is this machine's disk"; return 0; }
    # The projects folder first and on its own: projects need no pool.
    local rc=0
    apply_projects || rc=1
    local p; p="$(pool || true)"
    if [ -z "$p" ]; then
        named_projects >/dev/null || hold_projects
        echo "system-pool: no system pool named yet: docker, containerd and libvirt wait for one (This machine's The stick)"
        return "$rc"
    fi
    if ! mounted "$p"; then
        hold_secrets
        echo "system-pool: $p is not mounted yet: tried again in half a minute" >&2
        return 1
    fi
    # This install named the pool: one named before the mark is marked now.
    [ -s "$p/$SUB/$OWNER_MARK" ] || mark_pool "$p" || true
    local line name place src waited=""
    held "$(secrets_place)" && waited=1
    while IFS= read -r line; do
        name="${line%%=*}"; place="${line#*=}"; src="$p/$SUB/$name"
        mkdir -p "$src" "$place"
        unhold "$place"
        if lasting "$name"; then
            # The image binds these from the data partition: the pool's goes
            # over that one, so here "mounted" is not "there" (B669).
            # Only ever over the image's own: a plain folder there was never
            # moved (set_pool), so the pool's empty one must not cover it.
            if findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; then
                on_it "$place" "$src" || mount --bind "$src" "$place"
            fi
            continue
        fi
        if ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; then
            [ "$name" = secrets ] && secrets_shut "$src" "$place"
            [ -n "$(ls -A "$src" 2>/dev/null)" ] || as_place "$src" "$place"
            # Secrets a stick kept before they went to the pool (a pool named
            # by an earlier release) go there once, never hidden under an
            # empty folder of the pool's: the key in them is the one the
            # controller sealed under.
            if [ "$name" = secrets ] && [ -z "$(ls -A "$src" 2>/dev/null)" ] && [ -n "$(ls -A "$place" 2>/dev/null)" ]; then
                cp -a "$place/." "$src/"
                find "$place" -mindepth 1 -delete
                echo "system-pool: the secrets moved from the stick to $p"
            fi
        fi
        if ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; then
            mount --bind "$src" "$place"
        fi
    done < <(targets)
    # A controller that started while its secrets were held has no key: it
    # starts again on the pool's.
    if [ -n "$waited" ] && [ -z "${BB_SP_NO_SYSTEMCTL:-}" ] && systemctl is-active --quiet "$CONTROLLER" 2>/dev/null; then
        systemctl restart --no-block "$CONTROLLER" 2>/dev/null || true
    fi
    mkdir -p "$RUN"; : > "$READY"
    # The held services start now their condition holds; at boot this runs
    # before them, so systemd starts them in order anyway.
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "${SERVICES[@]/%/.service}" 2>/dev/null || true
    echo "system-pool: on $p: $(targets | cut -d= -f1 | paste -sd, -)"
    return "$rc"
}

# projects PATH [NAME...]: an existing folder taken as the projects folder.
# Who had a projects folder before it was handed over, written as a script in
# the folder itself (B665): it stays with the disks, so it runs on the other
# system too, which has no AerieOS and has only what is on them. Let it go
# runs it here. Nothing is written over one that is there, and a folder already
# the account's own has nothing to give back. Relative paths, so it works from
# wherever that system mounts the folder.
GIVE_BACK=".aerieos-give-back.sh"
note_owners() {
    local f="$1" acct="$2" s="$1/$GIVE_BACK" uid gid mode
    [ -e "$s" ] && return 0
    uid="$(stat -c %u "$f")"; gid="$(stat -c %g "$f")"; mode="$(stat -c %a "$f")"
    if [ -z "${BB_SP_NO_MOUNT:-}" ] && [ "$uid" = "$(id -u "$acct" 2>/dev/null)" ]; then return 0; fi
    {
        printf '#!/bin/bash\n# Written by AerieOS when this folder became its spaces folder: gives the\n'
        printf '# folder back to who had it. Run it as root, on this system or the one before.\n'
        printf 'set -e\ncd "$(dirname "$(readlink -f "$0")")"\n'
        printf 'chown -R %s:%s .\n' "$uid" "$gid"
        local who rel
        while IFS= read -r -d '' who && IFS= read -r -d '' rel; do
            printf 'chown -h %s %q\n' "$who" "./$rel"
        done < <(find "$f" -mindepth 1 \( ! -uid "$uid" -o ! -gid "$gid" \) -printf '%U:%G\0%P\0')
        printf 'chmod %s .\n' "$mode"
        printf 'rm -f -- %q\n' "$GIVE_BACK"
    } > "$s.new" || { rm -f "$s.new"; echo "system-pool: could not write in $f, so it stays as it is" >&2; return 2; }
    # The copy Let it go runs as root is root's own, outside the folder: the
    # one in it is handed to the controller's account with the rest, and
    # anything running as that account could add to it (B719). It goes into
    # the folder by its path, not its own place.
    local own; own="$(give_back_of "$f")"
    mkdir -p "$(dirname "$own")"; chmod 0700 "$(dirname "$own")"
    { printf '#!/bin/bash\nset -e\ncd -- %q\n' "$f"; sed '1,/^cd /d' "$s.new"; } > "$own.new" \
        || { rm -f "$s.new" "$own.new"; echo "system-pool: could not keep the give-back beside the system, so $f stays as it is" >&2; return 2; }
    chmod 0700 "$own.new"; mv -f "$own.new" "$own"
    mv -f "$s.new" "$s"
}
# Where root keeps the give-back of folder $1.
give_back_of() { printf '%s/give-back/%s.sh\n' "$WORK" "$(printf '%s' "$1" | sha256sum | cut -c1-16)"; }

set_projects() {
    local f="${1:-}"; shift || true
    stick || { echo "system-pool: only a stick boot takes a spaces folder this way" >&2; return 2; }
    case "$f" in /*) ;; *) echo "system-pool: a spaces folder is named by its path" >&2; return 2 ;; esac
    case "/$f/" in */../*|*/./*) echo "system-pool: a spaces folder is named by its path, with no . or .." >&2; return 2 ;; esac
    [ -d "$f" ] || { echo "system-pool: $f is not a folder on this machine" >&2; return 2; }
    local place src_dev f_dev
    place="$(projects_place)"
    src_dev="$(findmnt -rn -o SOURCE --target "${BB_SP_VAR:-/var}" 2>/dev/null || true)"
    f_dev="$(findmnt -rn -o SOURCE --target "$f" 2>/dev/null || true)"
    if [ -n "$src_dev" ] && [ "$src_dev" = "$f_dev" ]; then
        echo "system-pool: $f is on the stick itself: name a folder on the machine's disks" >&2; return 2
    fi
    case "$f" in "$place"|"$place"/*) echo "system-pool: $f is the spaces folder itself" >&2; return 2 ;; esac
    if findmnt -rn -o OPTIONS --target "$f" 2>/dev/null | tr , '\n' | grep -qx ro; then
        echo "system-pool: $f is mounted read only (its disks were adopted read only): adopt them writable first" >&2; return 2
    fi
    # Which of the controller's projects it holds, said before anything moves.
    local n found=0 missing=()
    for n in "$@"; do
        if [ -d "$f/$n" ]; then found=$((found + 1)); else missing+=("$n"); fi
    done
    [ "$#" -eq 0 ] || echo "system-pool: $f holds $found of the controller's $# spaces${missing[*]:+; not there: ${missing[*]}}"
    # Its files handed to the controller's account, as a projects folder it
    # made is: another system's (uid 99, say) is refused by git as dubious
    # and cannot be written. Nothing in them changes but their owner.
    local acct grp
    acct="$(envget BB_ACCOUNT)"; acct="${acct:-aerieos}"
    grp="$(id -gn "$acct" 2>/dev/null || true)"
    note_owners "$f" "$acct" || return 2
    echo "system-pool: to give it back: Let it go here, or as root on the system that had it: bash $f/$GIVE_BACK"
    if [ -z "${BB_SP_NO_MOUNT:-}" ]; then
        id "$acct" >/dev/null 2>&1 || { echo "system-pool: no account $acct here to hand the folder to" >&2; return 2; }
        echo "system-pool: handing $f to $acct (its files' owner alone)"
        chown -R "$acct${grp:+:$grp}" "$f"
        # The top closed to others: the wall refuses every session on this
        # machine while anybody can walk into the projects (B596).
        chmod 0750 "$f"
    fi
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl stop "$CONTROLLER" 2>/dev/null || true
    if bound "$place" && [ -z "${BB_SP_NO_MOUNT:-}" ] && ! umount "$place"; then
        echo "system-pool: $place is busy and stays as it is: close what holds it and name the folder again" >&2
        [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
        return 1
    fi
    # What lay in the projects folder before stays where it was, under the
    # bind, never deleted: letting the folder go shows it again.
    [ -n "$(ls -A "$place" 2>/dev/null)" ] && echo "system-pool: what $place held before stays underneath, unseen while $f is the spaces folder"
    mkdir -p "$WORK"
    printf '%s\n' "$f" > "$PFILE.new"; mv -f "$PFILE.new" "$PFILE"
    apply_projects
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
}

# projects --release: the folder let go, the pool's projects (or the
# stick's) bound again; the folder itself and its files stay as they are.
release_projects() {
    local place f
    place="$(projects_place)"; f="$(named_projects || true)"
    [ -n "$f" ] || { echo "system-pool: no spaces folder is named"; return 0; }
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl stop "$CONTROLLER" 2>/dev/null || true
    if bound "$place" && [ -z "${BB_SP_NO_MOUNT:-}" ] && ! umount "$place"; then
        echo "system-pool: $place is busy: close what holds it and let it go again" >&2
        [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
        return 1
    fi
    rm -f "$PFILE"
    echo "system-pool: $f is no longer the spaces folder; its files stay where they are"
    local own; own="$(give_back_of "$f")"
    if [ -f "$own" ]; then
        if bash "$own"; then echo "system-pool: $f is given back to who had it"; rm -f "$own"
        else echo "system-pool: $f could not be given back: run bash $own as root" >&2; fi
    elif [ -f "$f/$GIVE_BACK" ]; then
        # Only the folder's own copy, which its files' owner could have
        # changed: never run as root here, said instead.
        echo "system-pool: $f has its give-back inside it only ($GIVE_BACK): read it, then run it as root to give the folder back" >&2
    fi
    local p; p="$(pool || true)"
    if [ -n "$p" ] && mounted "$p" && [ -z "${BB_SP_NO_MOUNT:-}" ]; then
        mkdir -p "$p/$SUB/projects"
        mount --bind "$p/$SUB/projects" "$place"
    elif [ -z "$p" ]; then
        hold_projects
    fi
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
}

set_pool() {
    local p="${1:-}"
    stick || { echo "system-pool: only a stick boot takes a system pool" >&2; return 2; }
    case "$p" in /*) ;; *) echo "system-pool: a pool is named by its mount point" >&2; return 2 ;; esac
    mounted "$p" || { echo "system-pool: $p is not a mounted pool" >&2; return 2; }
    # A pool is a disk's: the stick's own root (/, in memory on a stick) or
    # any folder of memory would take the system's data and lose it at the
    # next boot (B719).
    local fst="${BB_SP_FSTYPE:-}"
    [ -n "$fst" ] || [ -n "${BB_SP_MOUNTED:-}" ] || fst="$(findmnt -rn -o FSTYPE --target "$p" 2>/dev/null || echo unknown)"
    case "$fst" in
        tmpfs|ramfs|overlay|squashfs|devtmpfs|proc|sysfs|unknown)
            echo "system-pool: $p is not on a disk (memory, or the system's own image): name a pool on the machine's disks" >&2; return 2 ;;
    esac
    local var_src p_src
    var_src="$(findmnt -rn -o SOURCE --target "${BB_SP_VAR:-/var}" 2>/dev/null || true)"
    p_src="$(findmnt -rn -o SOURCE --target "$p" 2>/dev/null || true)"
    if [ -n "$var_src" ] && [ "$var_src" = "$p_src" ]; then
        echo "system-pool: $p is on the stick itself: name a pool on the machine's disks" >&2; return 2
    fi
    if [ "$(pool_owner "$p")" = other ]; then
        if [ "${2:-}" != --aside ]; then
            echo "system-pool: $p holds another AerieOS install's data ($p/$SUB): it is never taken by a new install. Move that controller here with its move token, set it aside, or pick a pool without it; nothing on $p was touched" >&2
            return 3
        fi
        # Set aside, never taken (the operator, 8 Nov): renamed beside it
        # as it is, to be deleted by a person once sure, and this install
        # starts on an empty folder.
        local aside
        aside="$(aside_name "$p")"
        mv -T "$p/$SUB" "$aside" || { echo "system-pool: $p/$SUB could not be set aside; nothing on $p was touched" >&2; return 1; }
        echo "system-pool: the other install's $p/$SUB is set aside as $aside, untouched: delete it once nothing in it is wanted"
    fi
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl stop "${SERVICES[@]/%/.service}" 2>/dev/null || true
    mark_pool "$p"
    local line name place src old_pool
    old_pool="$(pool || true)"
    while IFS= read -r line; do
        name="${line%%=*}"; place="${line#*=}"; src="$p/$SUB/$name"
        mkdir -p "$src"
        if lasting "$name"; then
            # Only ever a mount: a plain /home is not the image's bind, and
            # nothing of it is moved or deleted (a tool run where it does not
            # belong).
            if [ -z "${BB_SP_NO_MOUNT:-}" ] && ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; then
                echo "system-pool: $place is not the image's own mount, and stays as it is" >&2
                continue
            fi
            # Moved through what shows there, which is the data partition or
            # the old pool, then only an old pool's bind comes down: the image's
            # stays underneath for the day the pool is gone (B669).
            if ! on_it "$place" "$src"; then
                if [ -d "$place" ] && [ -n "$(ls -A "$place" 2>/dev/null)" ]; then
                    cp -a "$place/." "$src/"
                    find "$place" -mindepth 1 -delete
                fi
                [ -n "$old_pool" ] && on_it "$place" "$old_pool/$SUB/$name" && { umount "$place" || {
                    echo "system-pool: $place is busy and stays where it is: close what holds it and set the pool again" >&2
                    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "${SERVICES[@]/%/.service}" 2>/dev/null || true
                    return 1; }; }
            fi
            continue
        fi
        # Unmounted until nothing is mounted there, and the move stopped
        # whole while something still is: a copy and a delete through a
        # bind still standing (a second one stacked under the first by two
        # applies at once) would empty the old pool (B476, B613). Nothing
        # more moves; what moved stays.
        # The secrets are the one folder carried from an old pool to the new:
        # the install key in them opens what the controller sealed, and the
        # stick's folder under the bind is empty.
        if [ "$name" = secrets ] && findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place" \
                && ! held "$place" && ! on_it "$place" "$src"; then
            cp -an "$place/." "$src/"
        fi
        unhold "$place"
        [ "$name" = secrets ] && secrets_shut "$src" "$place"
        local tries=0
        while findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; do
            if [ "$tries" -ge 8 ] || ! umount "$place"; then
                echo "system-pool: $place is busy and stays where it is: close what holds it and set the pool again" >&2
                [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "${SERVICES[@]/%/.service}" 2>/dev/null || true
                return 1
            fi
            tries=$((tries + 1))
        done
        [ -n "$(ls -A "$src" 2>/dev/null)" ] || as_place "$src" "$place"
        # What the stick holds of it goes to the pool once, then off the stick.
        if [ -d "$place" ] && [ -n "$(ls -A "$place" 2>/dev/null)" ]; then
            cp -a "$place/." "$src/"
            find "$place" -mindepth 1 -delete
        fi
    done < <(targets)
    mkdir -p "$WORK"
    printf '%s\n' "$p" > "$FILE.new"; mv -f "$FILE.new" "$FILE"
    apply
}

status() {
    local p ready=false on_stick=() kb="" since="" dev line name place
    stick || { echo '{"stick": false}'; return 0; }
    p="$(pool || true)"
    [ -e "$READY" ] && ready=true
    while IFS= read -r line; do
        name="${line%%=*}"; place="${line#*=}"
        if lasting "$name"; then
            { [ -z "$p" ] || ! on_it "$place" "$p/$SUB/$name"; } && [ -n "$(ls -A "$place" 2>/dev/null)" ] && on_stick+=("\"$name\"")
            continue
        fi
        if ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place" && [ -n "$(ls -A "$place" 2>/dev/null)" ]; then
            on_stick+=("\"$name\"")
        fi
    done < <(targets)
    dev="$(basename "$(findmnt -rn -o SOURCE --target "${BB_SP_VAR:-/var}" 2>/dev/null || true)")"
    [ -n "$dev" ] && [ -r "/sys/fs/ext4/$dev/lifetime_write_kbytes" ] && kb="$(cat "/sys/fs/ext4/$dev/lifetime_write_kbytes")"
    [ -n "$dev" ] && [ -r "/sys/fs/ext4/$dev/session_write_kbytes" ] && since="$(cat "/sys/fs/ext4/$dev/session_write_kbytes")"
    local IFS=,
    local pf home; pf="$(named_projects || true)"
    # Where the projects are: a named folder on the disks, the pool's, or
    # held (nowhere yet: never the stick).
    if [ -n "$pf" ]; then home="folder"; elif [ -n "$p" ] && [ "$ready" = true ]; then home="pool"; else home="held"; fi
    local oth; oth="$(others | paste -sd, -)"
    printf '{"stick": true, "pool": "%s", "ready": %s, "on_stick": [%s], "written_kb": %s, "boot_written_kb": %s, "projects": "%s", "projects_bound": %s, "projects_home": "%s", "others": [%s]}\n' \
        "${p//\"/}" "$ready" "${on_stick[*]}" "${kb:-null}" "${since:-null}" "${pf//\"/}" \
        "$( { [ -n "$pf" ] && bound "$(projects_place)" && ! held "$(projects_place)"; } && echo true || echo false)" "$home" "$oth"
}

case "${1:-}" in
    apply) apply ;;
    set) set_pool "${2:-}" "${3:-}" ;;
    projects)
        if [ "${2:-}" = --release ]; then release_projects; else shift; set_projects "$@"; fi ;;
    status) status ;;
    *) echo "usage: system-pool apply | set PATH [--aside] | spaces PATH [NAME...] | spaces --release | status" >&2; exit 64 ;;
esac

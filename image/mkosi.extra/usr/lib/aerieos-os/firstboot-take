#!/usr/bin/env python3
"""A prepared configuration's first boot (R161 step 8), as root, before the
controller starts: aerieos/firstboot.json on the ESP holds, after its
marker line, the JSON a stick maker's --config wrote (format 1, docs/image.md).
When it does, the machine's own part is applied here (the hostname, the time
zone, a static address written to the stick's aerieos.env), the rest is handed to the controller's account under
/run/aerieos-os/firstboot/, and the file on the stick is blanked in place,
its size kept, so the password hash it may carry is never left on the stick.
The controller applies what it was handed and says what it did on This
machine. A blank file is a plain stick: nothing happens.
"""
import json
import os
import pwd
import re
import subprocess
import sys

ESP = os.environ.get("BB_ESP", "/boot/efi")
RUN = os.path.join(os.environ.get("BB_OS_RUN", "/run/aerieos-os"), "firstboot")
ENV = os.environ.get("BB_CONTROLLER_ENV", "/etc/aerieos-controller/controller.env")
MARK = b"AERIE-FIRSTBOOT-1\n"
HOST = re.compile(r"[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?")
ZONE = re.compile(r"[A-Za-z0-9_+-]+(/[A-Za-z0-9_+-]+){0,2}")


def account():
    name = "aerieos"
    try:
        with open(ENV, encoding="utf-8") as f:
            for line in f:
                if line.startswith("BB_ACCOUNT="):
                    name = line.split("=", 1)[1].strip().strip('"') or name
    except OSError:
        pass
    try:
        return pwd.getpwnam(name)
    except KeyError:
        return None


def run(*argv):
    try:
        r = subprocess.run(argv, capture_output=True, text=True, timeout=30, check=False)
        return "" if r.returncode == 0 else (r.stderr or r.stdout).strip()[:200] or f"exit {r.returncode}"
    except (OSError, subprocess.TimeoutExpired) as e:
        return str(e)


ETC = os.environ.get("BB_ETC", "/etc")
ZONEINFO = os.environ.get("BB_ZONEINFO", "/usr/share/zoneinfo")
KHOST = os.environ.get("BB_KERNEL_HOSTNAME", "/proc/sys/kernel/hostname")


def set_hostname(host):
    """The hostname written where systemd reads it at every boot (/etc/hostname)
    and set on the running kernel: what hostnamectl does, without the bus.
    This runs from aerieos-os-env.service, before D-Bus is up, where
    hostnamectl and timedatectl answered 'Failed to connect to system scope
    bus' and the stick's hostname and time zone were never set (2 Nov, the
    first boot of 0.9.0-dev.4809 in a VM)."""
    try:
        with open(os.path.join(ETC, "hostname"), "w", encoding="utf-8") as f:
            f.write(host + "\n")
        with open(KHOST, "w", encoding="utf-8") as f:
            f.write(host)
    except OSError as e:
        return f"could not set: {e}"
    return "applied"


def set_timezone(zone):
    """/etc/localtime pointed at the zone's file and /etc/timezone named, as
    timedatectl sets them, without the bus."""
    try:
        link = os.path.join(ETC, "localtime")
        tmp = link + ".new"
        if os.path.lexists(tmp):
            os.unlink(tmp)
        os.symlink(os.path.join("..", "usr", "share", "zoneinfo", zone) if ZONEINFO == "/usr/share/zoneinfo" else os.path.join(ZONEINFO, zone), tmp)
        os.replace(tmp, link)
        with open(os.path.join(ETC, "timezone"), "w", encoding="utf-8") as f:
            f.write(zone + "\n")
    except OSError as e:
        return f"could not set: {e}"
    return "applied"


NETKEYS = (("address", "BB_NET_ADDRESS"), ("netmask", "BB_NET_MASK"), ("gateway", "BB_NET_GATEWAY"), ("dns", "BB_NET_DNS"))
ADDR = re.compile(r"[0-9]{1,3}(\.[0-9]{1,3}){3}|[0-9]{1,2}")


def network(net):
    """A static address in the configuration becomes the stick's own network
    settings (R161 step 12): BB_NET_* lines added to aerieos.env in its
    4 KiB, so every boot's network step applies them, this one included
    (they go to its file under /run too). A line the stick already has, as
    a stick maker's --set wrote it, is kept over the configuration's."""
    if not isinstance(net, dict) or net.get("dhcp") is True:
        return ""
    lines = []
    for k, key in NETKEYS:
        v = net.get(k)
        v = ",".join(str(x) for x in v) if isinstance(v, list) else str(v or "")
        if v and not all(ADDR.fullmatch(x) for x in v.split(",")):
            return f"{k} {v!r} is not an address: DHCP stands"
        if v:
            lines.append(f"{key}={v}")
    if not lines or not lines[0].startswith("BB_NET_ADDRESS="):
        return "no address in it: DHCP stands"
    path = os.path.join(ESP, "aerieos.env")
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError:
        return "the stick has no aerieos.env to write the address into: DHCP stands; set the address on the Network page once the dashboard is up"
    if any(x.split("=", 1)[0].strip() == "BB_NET_ADDRESS" for x in raw.decode("utf-8", "replace").splitlines()):
        return "the stick's own BB_NET_ADDRESS kept"
    body = raw.rstrip(b" \n") + b"\n"
    add = "".join(x + "\n" for x in lines).encode()
    if not raw.endswith(b"\n") or len(body) + len(add) > len(raw) - 1:
        return "no room for the address in the stick's aerieos.env: DHCP stands; set it on the Network page once the dashboard is up"
    with open(path, "r+b") as f:
        f.write(body + add + b" " * (len(raw) - 1 - len(body) - len(add)) + b"\n")
        f.flush()
        os.fsync(f.fileno())
    os.makedirs(os.path.dirname(RUN), exist_ok=True)
    with open(os.path.join(os.path.dirname(RUN), "net"), "a", encoding="utf-8") as f:
        f.write(add.decode())
    return "applied"


MIRROR = b"BB-MIRROR-1\n"


# The kernel arguments a prepared configuration may carry (machine.kernel_args):
# what VMs given a machine's own devices and CPUs need, as the machine it
# replaces booted with. Anything else is said and left out.
KARGS = {"isolcpus", "nohz_full", "rcu_nocbs", "irqaffinity", "intel_iommu", "amd_iommu", "iommu",
         "pcie_acs_override", "video", "vfio-pci.ids", "vfio_iommu_type1.allow_unsafe_interrupts",
         "kvm.ignore_msrs", "kvm.report_ignored_msrs", "kvm_intel.nested", "kvm_amd.nested", "kvm_amd.npt",
         "hugepages", "hugepagesz", "default_hugepagesz", "transparent_hugepage", "pcie_aspm",
         "initcall_blacklist", "modprobe.blacklist"}
KARG = re.compile(r"[a-z][a-z0-9_.-]{0,63}(=[A-Za-z0-9_.,:=/@+-]{1,256})?")
SLOT = os.environ.get("BB_SLOT", "/usr/lib/aerieos-os/slot")
FEATURES = os.environ.get("BB_OS_FEATURES", "/var/lib/aerieos-os/features")


def kernel_args(args):
    """machine.kernel_args onto every boot entry, from the next boot: what
    happened, in words."""
    took, left = [], []
    for a in args if isinstance(args, list) else []:
        a = str(a)
        (took if KARG.fullmatch(a) and a.split("=", 1)[0] in KARGS else left).append(a)
    said = ""
    if took:
        err = run("bash", SLOT, "args", *took)
        said = f"{' '.join(took)} from the next restart" if not err else f"not set: {err}"
    if left:
        said += ("; " if said else "") + f"left out (not an argument this sets): {' '.join(x[:40] for x in left[:8])}"
    return said


def features(want):
    """machine.features, turned on with the machine's own node as the
    installer's are: the names added to its list."""
    names = [f for f in (want if isinstance(want, list) else []) if f in ("vmhost", "iommu")]
    if not names:
        return ""
    try:
        with open(FEATURES, encoding="utf-8") as f:
            have = {ln.strip() for ln in f if ln.strip()}
    except OSError:
        have = set()
    new = [f for f in names if f not in have]
    if new:
        os.makedirs(os.path.dirname(FEATURES), exist_ok=True)
        with open(FEATURES, "a", encoding="utf-8") as f:
            f.write("".join(n + "\n" for n in new))
    return "turned on with this machine's node: " + ", ".join(names)


def mirror(pw):
    """The catalog's mirror a stick maker's --mirror wrote (R169 step 6):
    handed to the controller at every boot while the stick holds one, which
    imports it once per mirror. The stick keeps it: it holds nothing secret."""
    path = os.path.join(ESP, "aerieos", "catalog-mirror.bin")
    try:
        with open(path, "rb") as f:
            head = f.read(len(MIRROR) + 13)
            if not head.startswith(MIRROR) or not head[len(MIRROR):len(MIRROR) + 12].isdigit():
                return ""
            n = int(head[len(MIRROR):len(MIRROR) + 12])
            if n <= 0:
                return ""
            data = f.read(n)
    except OSError:
        return ""
    if len(data) != n:
        return "the stick's mirror is cut short"
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    if pw:
        os.chown(RUN, pw.pw_uid, pw.pw_gid)
    out = os.path.join(RUN, "catalog-mirror.tar.gz")
    with open(os.open(out + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "wb") as f:
        f.write(data)
    if pw:
        os.chown(out + ".new", pw.pw_uid, pw.pw_gid)
    os.replace(out + ".new", out)
    return f"a mirror of the catalog ({n >> 10} KiB) handed to the controller"


def main():
    said = mirror(account())
    if said:
        print(f"firstboot-take: {said}")
    path = os.path.join(ESP, "aerieos", "firstboot.json")
    try:
        with open(path, "rb") as f:
            raw = f.read()
    except OSError:
        return 0
    if not raw.startswith(MARK) or not raw[len(MARK):].strip():
        return 0
    said = {}
    try:
        cfg = json.loads(raw[len(MARK):].decode("utf-8"))
        if not isinstance(cfg, dict) or cfg.get("format") != 1:
            raise ValueError("not a prepared configuration of format 1")
    except (ValueError, UnicodeDecodeError) as e:
        cfg, said["file"] = None, f"could not be read: {e}"
    m = (cfg or {}).get("machine") or {}
    host, zone = str(m.get("hostname") or ""), str(m.get("timezone") or "")
    if host:
        said["hostname"] = set_hostname(host) if HOST.fullmatch(host) else f"{host!r} is not a hostname"
    if zone:
        ok = ZONE.fullmatch(zone) and os.path.isfile(os.path.join(ZONEINFO, zone))
        said["timezone"] = set_timezone(zone) if ok else f"{zone!r} is not a time zone here"
    net = network(m.get("network"))
    if net:
        said["network"] = net
    if m.get("kernel_args"):
        said["kernel_args"] = kernel_args(m["kernel_args"])
    if m.get("features"):
        said["features"] = features(m["features"])
    pw = account()
    os.makedirs(RUN, mode=0o700, exist_ok=True)
    if pw:
        os.chown(RUN, pw.pw_uid, pw.pw_gid)
    out = os.path.join(RUN, "firstboot.json")
    with open(os.open(out + ".new", os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600), "w", encoding="utf-8") as f:
        json.dump({"config": cfg, "machine": said}, f)
    if pw:
        os.chown(out + ".new", pw.pw_uid, pw.pw_gid)
    os.replace(out + ".new", out)
    # Blanked in place, its size kept: the stick maker finds it again by its
    # marker, and nothing of what it held stays on the stick.
    with open(path, "r+b") as f:
        f.write(MARK + b" " * (len(raw) - len(MARK) - 1) + b"\n")
        f.flush()
        os.fsync(f.fileno())
    print(f"firstboot-take: a prepared configuration was taken off the stick ({', '.join(f'{k} {v}' for k, v in said.items()) or 'nothing of the machine in it'})")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# The AerieOS installer (R160 step 2), on the console of a machine
# booted from the ISO (bbinstaller=1 on the kernel's command line): the disk
# to install onto, what will be lost on it, the features to turn on at the
# first boot, then the disk laid out by the same script that made the image
# (lay-disk, on the ISO's own squashfs, kernel and initrd), the features
# written for the first boot, and a restart. Nothing else is asked: the
# owner, the network and the name are the dashboard's first page's.
set -euo pipefail
LIVE="${BB_LIVE_MEDIUM:-/run/live/medium}"
LIB=/usr/lib/aerieos-os
# With no questions, where the kernel's command line names the disk
# (aerie_install_to=/dev/vda, beside bbinstaller=1): for a machine nobody sits
# at, and for the build's own check that this ISO installs (the image
# workflow boots it so on a blank disk). Never chosen for a person: the menu
# does not carry the word, and without it every screen below asks. Each
# line it says goes to the kernel's console as well, which is where such a
# machine is read; it turns the machine off at its end, having restarted
# into the medium again otherwise.
AUTO=""
read -r cmdline < /proc/cmdline || cmdline=""
for w in $cmdline; do
    case "$w" in aerie_install_to=/dev/*) AUTO="${w#aerie_install_to=}" ;; esac
done
told() { echo "aerieos-installer: $1"; echo "aerieos-installer: $1" > /dev/console 2>/dev/null || true; }
say() { whiptail --title "AerieOS" --msgbox "$1" 14 72; }
bye() {
    if [ -n "$AUTO" ]; then
        told "FAILED: $1"
        sync; systemctl poweroff; sleep 600; exit 1
    fi
    whiptail --title "AerieOS" --msgbox "$1

Press Enter to get a shell; the installer runs again with: installer" 14 72; exec bash; }
export NEWT_COLORS='root=,black roottext=white,black window=white,black border=white,black title=green,black button=black,green actbutton=black,green listbox=white,black actlistbox=black,green checkbox=white,black actcheckbox=black,green'

[ -d "$LIVE/live" ] || bye "This is not the AerieOS medium: $LIVE/live is not here."
SQ="$(find "$LIVE/live" -maxdepth 1 -name '*.squashfs' | head -1)"
[ -f "$SQ" ] || bye "No root image on the medium (live/*.squashfs)."
VER="$(sed -n 's/^BUILDERBOT_OS_VERSION=//p' "$LIVE/live/release" 2>/dev/null | head -1)"

# Every disk this medium sits on, left out of the offer: through a dm
# mapping (Ventoy) by lsblk's inverse tree, and through a loop device (an
# ISO file on a stick) by its backing file's own filesystem (B473).
medium_dev="$(findmnt -no SOURCE "$LIVE" 2>/dev/null | sed 's/\[.*//')"
case "$medium_dev" in /dev/loop*)
    back="$(losetup -nO BACK-FILE "$medium_dev" 2>/dev/null | head -1)"
    [ -n "$back" ] && medium_dev="$(findmnt -no SOURCE -T "$back" 2>/dev/null | sed 's/\[.*//')" ;;
esac
medium_disks="$(basename "${medium_dev:-none}")"
[ -n "$medium_dev" ] && medium_disks="$medium_disks $(lsblk -nsrpo NAME,TYPE "$medium_dev" 2>/dev/null | awk '$2 == "disk" {sub(".*/", "", $1); print $1}' | tr '\n' ' ')"

# The disks to offer, one "NAME<tab>what it is" a line: read from lsblk's
# JSON, since a model with spaces or none at all shifted read's columns and
# left a machine's own disks out (B473). A disk with anything mounted is in
# use and never offered.
disk_rows() {
    lsblk -J -b -p -o NAME,SIZE,MODEL,TRAN,TYPE,MOUNTPOINTS 2>/dev/null | python3 -c '
import json, sys
skip = set(sys.argv[1].split())
def mounted(d):
    return any(m for m in d.get("mountpoints") or [] if m) or any(mounted(c) for c in d.get("children") or [])
for d in json.load(sys.stdin).get("blockdevices") or []:
    n = str(d.get("name") or "")
    if d.get("type") != "disk" or n.rsplit("/", 1)[-1] in skip or mounted(d):
        continue
    if n.startswith(("/dev/loop", "/dev/ram", "/dev/zram", "/dev/sr")):
        continue
    model = " ".join(str(d.get("model") or "").replace("_", " ").split())[:40]
    tran = str(d.get("tran") or "")
    gb = int(d.get("size") or 0) / 1e9
    print(f"{n}\t{gb:.0f} GB {model}" + (f" · {tran}" if tran else ""))
' "$medium_disks"
}

# AerieOS's logo over the welcome (R185), the one the console shows at
# every boot.
LOGO="$(cat "$LIB/logo" 2>/dev/null || true)"
[ -n "$AUTO" ] || whiptail --title "AerieOS" --msgbox "$LOGO

Welcome to AerieOS ${VER:-}.

This installs it onto a disk of this machine: the whole disk is laid out again (two root slots for updates and a data partition grown to the disk), and everything on it is lost. The machine comes up as its own controller, reached on the LAN at http://ITS-ADDRESS:7680, where the first page makes the owner." 24 76

pick=""
if [ -n "$AUTO" ]; then
    # The disk the line named, if it is one this installer would offer: not
    # the medium, nothing of it mounted.
    disk_rows | cut -f1 | grep -qx "$AUTO" \
        || bye "$AUTO is not a disk to install onto here: $(disk_rows | cut -f1 | tr '\n' ' ')"
    pick="$AUTO"
    told "laying out $pick as AerieOS ${VER:-}"
fi
while [ -z "$pick" ]; do
    rows=()
    while IFS=$'\t' read -r name what; do
        [ -n "$name" ] && rows+=("$name" "$what")
    done < <(disk_rows)
    [ "${#rows[@]}" -gt 0 ] || bye "No disk to install onto: this machine shows none beside the medium it booted from, and none with nothing mounted."
    pick="$(whiptail --title "AerieOS" --menu "The disk to install onto. Everything on it is lost." 20 72 8 "${rows[@]}" 3>&1 1>&2 2>&3)" || bye "Nothing installed."
    # What is on it now, so the disk is known by its contents and not its
    # name alone.
    on="$(lsblk -no NAME,SIZE,FSTYPE,LABEL,MODEL "$pick" 2>/dev/null | head -8)"
    whiptail --title "AerieOS" --yesno "Lay out $pick as AerieOS?

${on:-(nothing could be read from it)}

Every partition on it is replaced. There is no undo." 20 76 --defaultno || pick=""
done

# Only what the first boot can turn on here is offered, and ticked only where
# it will work (B768): the VM host needs this CPU's virtualization (no
# /dev/kvm in a VM without it, and the first boot refused it in the journal
# alone), and the hosting firewall is a hosting-only node's, refused on a
# machine that runs sessions, which every machine installed from here does,
# so it is not asked about.
feats=""
kvm=OFF vmwhat="VM host: KVM through libvirt, for the VMs page"
if [ -e /dev/kvm ] || grep -qE '^flags[[:space:]]*:.*[[:space:]](vmx|svm)([[:space:]]|$)' /proc/cpuinfo 2>/dev/null; then
    kvm=ON
else
    vmwhat="VM host: this CPU shows no virtualization, so VMs cannot run here"
fi
[ -n "$AUTO" ] || feats="$(whiptail --title "AerieOS" --checklist "Features turned on at the first boot (each can change later on This machine):" 16 76 3 \
    vmhost "$vmwhat" "$kvm" \
    iommu "IOMMU on the kernel's command line, for PCI and USB passthrough" OFF 3>&1 1>&2 2>&3)" || bye "Nothing installed."

[ -n "$AUTO" ] || clear
echo "== laying out $pick"
if ! bash "$LIB/lay-disk" "$pick" "$SQ" "$LIVE/live/vmlinuz" "$LIVE/live/initrd" "$LIVE/live/release" "$LIB/grub.cfg" --grow; then
    bye "The disk was not laid out (above). Nothing is installed; $pick may be partly written."
fi
# The features chosen, onto the data partition of the disk just laid out:
# its fifth, as lay-disk numbers it, never found by its UUID, which every
# AerieOS disk shares (B473).
case "$pick" in *[0-9]) data="${pick}p5" ;; *) data="${pick}5" ;; esac
mnt="$(mktemp -d)"
wrote=""
if [ -b "$data" ] && mount "$data" "$mnt" 2>/dev/null; then
    mkdir -p "$mnt/lib/aerieos-os"
    echo "$feats" | tr -d '"' | tr ' ' '\n' | grep . > "$mnt/lib/aerieos-os/features" || true
    [ -f "$mnt/lib/aerieos-os/features" ] && wrote=1
    umount "$mnt"
fi
rmdir "$mnt" 2>/dev/null || true
[ -n "$wrote" ] || [ -n "$AUTO" ] || whiptail --title "AerieOS" --msgbox "The features chosen could not be written to $data, so none is on at the first boot: turn them on under This machine once the dashboard is up." 12 72
sync
if [ -n "$AUTO" ]; then
    told "AerieOS ${VER:-} is on $pick"
    systemctl poweroff; sleep 600; exit 0
fi
whiptail --title "AerieOS" --msgbox "AerieOS ${VER:-} is on $pick.

Take the medium out and press Enter to restart. The machine comes up as its own controller; the first page, at http://ITS-ADDRESS:7680 on the LAN, makes the owner." 14 72
systemctl reboot

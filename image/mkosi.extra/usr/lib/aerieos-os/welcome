#!/usr/bin/env bash
# The console's welcome at every boot (R185): AerieOS's logo, the release
# this slot runs and the address the dashboard answers at, above the login
# prompt. Written to /run/issue.d, which the console's getty reads with
# /etc/issue (blank in the image, so Debian's own line goes); its \4 is the
# getty's own placeholder for this machine's IPv4 address, filled in and
# redrawn as the network comes up, so the address is right without this
# step knowing it. The logo carries no backslash, an escape in an issue file.
set -euo pipefail
LIB="${BB_OS_LIB:-/usr/lib/aerieos-os}"
OUT="${BB_ISSUE_DIR:-/run/issue.d}/10-aerieos.issue"
ENV="${BB_CONTROLLER_ENV:-/etc/aerieos-controller/controller.env}"
ver="$(sed -n 's/^BUILDERBOT_OS_VERSION=//p' "$LIB/release" 2>/dev/null | head -n 1 || true)"
port="$(sed -n 's/^DASHBOARD_PORT=//p' "$ENV" 2>/dev/null | tail -n 1 | tr -dc '0-9' || true)"
mkdir -p "$(dirname "$OUT")"
{
    printf '\n'
    sed 's/\\/\\\\/g' "$LIB/logo"
    printf '\n        AerieOS%s, slot %s\n' "${ver:+ $ver}" "$("$LIB/slot" current 2>/dev/null || echo "?")"
    printf '        Open http://\\4:%s/ in a browser on this network.\n' "${port:-7680}"
    # The way in at this screen (R194): admin, once a console password is
    # set on the Nodes page; while the machine is first set up, with none
    # (console-door); otherwise, where to set one.
    if [ -s "${BB_CONSOLE_HASH:-$( [ -d /var/lib/aerieos ] && echo /var/lib/aerieos || echo /var/lib/builderbot )/console-hash}" ]; then
        printf '        Log in here as admin with the console password.\n'
    elif [ -e "${BB_CONSOLE_OPEN:-/var/lib/aerieos-os/console-open}" ]; then
        printf '        Until setup is finished, log in here as admin with no password.\n'
    else
        printf '        To log in here, set a console password on the Nodes page.\n'
    fi
    # ...and the way in when the dashboard itself is what does not answer
    # (B621): the boot menu's Rescue entry, which needs no password.
    printf '        If the dashboard does not answer, restart and pick Rescue on the boot menu\n'
    printf '        for a root shell here; journalctl -u aerieos-controller says why.\n\n'
} > "$OUT.new"
mv -f "$OUT.new" "$OUT"

#!/usr/bin/env bash
# The two root slots of an AerieOS disk (R160 step 1), read and set:
#
#   slot current         the slot this boot came from (a or b), from the kernel's command line
#   slot other           the one an update writes
#   slot next [a|b]      the slot GRUB boots next time (set, or printed when none is named)
#   slot status          the running release, both slots, which is next, and whether the root is in memory
#   slot ram [on|off]    whether GRUB loads the slot into memory at boot (the USB edition), read or set
#   slot trial PREV VER  the next boot is a trial of the slot "next" names, holding VER; PREV is the slot
#                        to go back to after two boots the health check never marked good
#   slot hold            the next boot is this one's slot, no trial: before an update writes the other
#   slot switch SLOT PREV VER   the next boot is a trial of SLOT holding VER, back to PREV: one write
#   slot good            this boot's slot is healthy: the trial ends, and it stays
#   slot fell-back [keep]   whether the last boot fell back to the slot before (and clears the mark, unless keep)
#   slot kept-next [VER]    one boot of the kept older version VER next (R201), or none named: no such boot
#   slot args [ARG...]   the kernel arguments every boot entry ends with, printed, or each ARG (NAME or
#                        NAME=VALUE) put there in place of one of that name: from the next boot
#   slot args-off NAME...   those arguments taken off, from the next boot
#
# GRUB keeps the choice in its environment block on the ESP (aerie_slot), the one
# place this tool writes. Counting a new slot's tries and marking it good is
# R161 step 2's, on top of this.
set -euo pipefail
ESP="${BB_ESP:-/boot/efi}"
ENVF="$ESP/grub/grubenv"
CMDLINE="${BB_CMDLINE:-/proc/cmdline}"
RELEASE="${BB_OS_RELEASE:-/usr/lib/aerieos-os/release}"

current() {
    local w
    local line
    read -r line < "$CMDLINE"
    for w in $line; do
        case "$w" in aerieslot=a|aerieslot=b) printf '%s\n' "${w#aerieslot=}"; return 0 ;; esac
    done
    echo "slot: this boot named no slot (aerieslot= is not on the kernel's command line), so it is not an AerieOS boot" >&2
    return 1
}
other() { [ "$(current)" = a ] && echo b || echo a; }
next() {
    case "${1:-}" in
        "")
            if [ -s "$ENVF" ]; then grub-editenv "$ENVF" list | sed -n 's/^aerie_slot=//p' | grep . || echo a
            else echo a; fi ;;
        a|b)
            [ -d "$ESP/grub" ] || { echo "slot: no GRUB at $ESP/grub: is the ESP mounted?" >&2; return 1; }
            [ -s "$ENVF" ] || grub-editenv "$ENVF" create
            grub-editenv "$ENVF" set "aerie_slot=$1" ;;
        *) echo "slot next takes a or b" >&2; return 2 ;;
    esac
}
ram() {
    case "${1:-}" in
        "")
            if [ -s "$ENVF" ]; then grub-editenv "$ENVF" list | grep -qx 'aerie_toram=1' && echo on || echo off
            else echo off; fi ;;
        on|off)
            [ -d "$ESP/grub" ] || { echo "slot: no GRUB at $ESP/grub: is the ESP mounted?" >&2; return 1; }
            [ -s "$ENVF" ] || grub-editenv "$ENVF" create
            if [ "$1" = on ]; then grub-editenv "$ENVF" set aerie_toram=1; else grub-editenv "$ENVF" unset aerie_toram; fi ;;
        *) echo "slot ram takes on or off" >&2; return 2 ;;
    esac
}
envget() { [ -s "$ENVF" ] && grub-editenv "$ENVF" list | sed -n "s/^$1=//p" | head -1 || true; }
needenv() { [ -d "$ESP/grub" ] || { echo "slot: no GRUB at $ESP/grub: is the ESP mounted?" >&2; return 1; }; [ -s "$ENVF" ] || grub-editenv "$ENVF" create; }
trial() {
    local prev="${1:-}" ver="${2:-}" nxt
    case "$prev" in a|b) ;; *) echo "slot trial takes the slot to go back to (a or b) and the version" >&2; return 2 ;; esac
    needenv || return 1
    nxt="$(next)"
    grub-editenv "$ENVF" set aerie_trial=1 aerie_tries=0 "aerie_prev=$prev" "aerie_ver_$nxt=$ver"
    grub-editenv "$ENVF" unset aerie_fell_back
}
# Before an update writes the other slot: the next boot is this one's, no
# trial, so a slot half written is never the one GRUB is pointed at (B470).
hold() {
    needenv || return 1
    local cur; cur="$(current)" || return 1
    grub-editenv "$ENVF" set "aerie_slot=$cur" aerie_trial=0 aerie_tries=0
}
# After it: the written slot booted next on trial, in one write of GRUB's
# environment, so a next without its trial never stands alone (B470).
switch() {
    local to="${1:-}" prev="${2:-}" ver="${3:-}"
    case "$to:$prev" in a:b|b:a) ;; *) echo "slot switch takes the slot written and the one to go back to (a b, or b a), and the version" >&2; return 2 ;; esac
    needenv || return 1
    grub-editenv "$ENVF" set "aerie_slot=$to" aerie_trial=1 aerie_tries=0 "aerie_prev=$prev" "aerie_ver_$to=$ver"
    grub-editenv "$ENVF" unset aerie_fell_back 2>/dev/null || true
}
# This boot is healthy. A trial ends only when this boot is the slot on
# trial; a boot of the other slot (picked from the menu) during one that has
# already booted ends the trial back on this slot, and one written during
# this boot and not booted yet is left to boot (B471). Nothing is written
# when nothing changes, so a healthy boot does not rewrite GRUB's
# environment each time.
good() {
    needenv || return 1
    local cur nxt ver
    # A kept older version is one boot's visit: the slots are as they were.
    grep -q 'aeriekept=' "$CMDLINE" 2>/dev/null && return 0
    cur="$(current 2>/dev/null || true)"
    [ -n "$cur" ] || return 0
    nxt="$(next)"
    if [ "$(envget aerie_trial)" = 1 ]; then
        if [ "$cur" = "$nxt" ]; then
            grub-editenv "$ENVF" set aerie_trial=0 aerie_tries=0
        elif [ "$(envget aerie_tries)" != 0 ]; then
            grub-editenv "$ENVF" set "aerie_slot=$cur" aerie_trial=0 aerie_tries=0
        fi
    fi
    ver="$( [ -r "$RELEASE" ] && sed -n 's/^BUILDERBOT_OS_VERSION=//p' "$RELEASE" | head -1 || true)"
    if [ -n "$ver" ] && [ "$(envget "aerie_ver_$cur")" != "$ver" ]; then
        grub-editenv "$ENVF" set "aerie_ver_$cur=$ver"
    fi
    return 0
}
# One boot of a kept older version next, GRUB spending the word (R201).
keptnext() {
    needenv || return 1
    case "${1:-}" in
        '') grub-editenv "$ENVF" unset aerie_kept_next ;;
        *[!A-Za-z0-9.+-]*) echo "slot kept-next takes a version" >&2; return 2 ;;
        *) grub-editenv "$ENVF" set "aerie_kept_next=$1" ;;
    esac
}
# A machine's own kernel arguments (aerie_args, which every entry of
# grub.cfg ends with): the IOMMU, a device held for VMs, CPUs kept for them.
# What the image's own entries say (its root, its slot, its overlay) is not
# an argument a person sets here.
argname() { printf '%s\n' "${1%%=*}"; }
argsok() {
    case "$(argname "$1")" in
        root|rootfstype|overlayroot|init|aerie*|systemd.unit|rd.*) echo "slot: $1 is the image's own argument, not one to set" >&2; return 1 ;;
    esac
    printf '%s\n' "$1" | grep -Eq '^[a-z][a-z0-9_.-]{0,63}(=[A-Za-z0-9_.,:=/@+-]{1,256})?$' || { echo "slot: $1 is not a kernel argument this sets" >&2; return 1; }
}
args() {
    local a w keep out
    if [ "$#" -eq 0 ]; then envget aerie_args; return 0; fi
    for a in "$@"; do argsok "$a" || return 2; done
    needenv || return 1
    out=""
    for w in $(envget aerie_args); do
        keep=1
        for a in "$@"; do [ "$(argname "$w")" = "$(argname "$a")" ] && keep=0; done
        [ "$keep" = 1 ] && out="${out:+$out }$w"
    done
    for a in "$@"; do out="${out:+$out }$a"; done
    grub-editenv "$ENVF" set "aerie_args=$out"
}
argsoff() {
    local a w keep out=""
    [ "$#" -gt 0 ] || { echo "slot args-off takes the names to take off" >&2; return 2; }
    needenv || return 1
    for w in $(envget aerie_args); do
        keep=1
        for a in "$@"; do [ "$(argname "$w")" = "$(argname "$a")" ] && keep=0; done
        [ "$keep" = 1 ] && out="${out:+$out }$w"
    done
    if [ -n "$out" ]; then grub-editenv "$ENVF" set "aerie_args=$out"; else grub-editenv "$ENVF" unset aerie_args; fi
}
fellback() {
    if [ "$(envget aerie_fell_back)" = 1 ]; then
        echo yes
        [ "${1:-}" = keep ] && return 0
        grub-editenv "$ENVF" unset aerie_fell_back 2>/dev/null || true
    else
        echo no
    fi
}
status() {
    local cur nxt inram=no
    cur="$(current 2>/dev/null || echo '?')"; nxt="$(next)"
    grep -qw 'aerietoram=1' "$CMDLINE" 2>/dev/null && inram=yes
    [ -r "$RELEASE" ] && sed 's/^/release: /' "$RELEASE"
    printf 'booted: slot %s\nnext boot: slot %s\nroot in memory: %s\n' "$cur" "$nxt" "$inram"
    [ "$(envget aerie_trial)" = 1 ] && printf 'trial: slot %s, %s boot(s) so far, back to slot %s after two without the health check\n' "$nxt" "$(envget aerie_tries)" "$(envget aerie_prev)"
    [ -n "$(envget aerie_ver_a)" ] && printf 'slot a: %s\n' "$(envget aerie_ver_a)"
    [ -n "$(envget aerie_ver_b)" ] && printf 'slot b: %s\n' "$(envget aerie_ver_b)"
    return 0
}
case "${1:-}" in
    current) current ;;
    other) other ;;
    next) next "${2:-}" ;;
    ram) ram "${2:-}" ;;
    trial) trial "${2:-}" "${3:-}" ;;
    hold) hold ;;
    switch) switch "${2:-}" "${3:-}" "${4:-}" ;;
    good) good ;;
    fell-back) fellback "${2:-}" ;;
    kept-next) keptnext "${2:-}" ;;
    status) status ;;
    args) shift; args "$@" ;;
    args-off) shift; argsoff "$@" ;;
    *) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

#!/usr/bin/env bash
# A boot GRUB brought back to the slot before (B472): the controller's
# configuration put back to the copy the update took under this slot
# (osimage.keep_state_before, before/VERSION.tar.gz), when the newer slot
# moved it on so far that this build's state gate refuses it. Run before the
# controller starts. What the configuration held is moved aside, never
# deleted. Says nothing on a boot that did not fall back, or when this build
# reads the configuration as it is.
set -euo pipefail
SLOT="${BB_OS_SLOT:-/usr/lib/aerieos-os/slot}"
WORK="${BB_OS_WORK:-/var/lib/aerieos-os}"
STATE="${BB_OS_STATE:-/var/lib/aerieos-controller/config}"
OPT="${BB_OS_OPT:-/opt/aerieos}"
RELEASE="${BB_OS_RELEASE:-/usr/lib/aerieos-os/release}"

CMDLINE="${BB_CMDLINE:-/proc/cmdline}"
MARK="$WORK/kept-set-aside"

# A visit to a kept older version (R201) ended: the configuration it set
# aside comes back, and what the visit did to the one it ran on is set aside.
kept=""
line=""
read -r line < "$CMDLINE" 2>/dev/null || true
for w in $line; do case "$w" in aeriekept=*) kept="${w#aeriekept=}" ;; esac; done
if [ -z "$kept" ] && [ -s "$MARK" ]; then
    back="$(head -1 "$MARK")"
    if [ -d "$back" ] && [ -d "$STATE" ]; then
        aside="$WORK/rolled-back-$(date +%Y%m%d-%H%M%S)-visit"
        mkdir -p "$aside"; chmod 0700 "$aside"
        mv "$STATE" "$aside/$(basename "$STATE")"
        mv "$back" "$STATE"
        echo "restore-before: back from the kept version: the configuration is as you left it; what the visit changed is in $aside"
    fi
    rm -f "$MARK"
fi
# The mark is read and left for the health check, which says it.
[ -d "$STATE" ] || exit 0
ver="$(sed -n "s/^BUILDERBOT_OS_VERSION=//p" "$RELEASE" 2>/dev/null | head -1 || true)"
bbver="$(sed -n "s/^BB_VERSION=//p" "$OPT/build.env" 2>/dev/null | head -1 || true)"
if [ -z "$kept" ] && [ "$(bash "$SLOT" fell-back keep 2>/dev/null)" != yes ]; then
    # Not a fall back: the older slot picked by hand from the boot menu.
    # Its copy goes back only when a newer build wrote the configuration,
    # never over one that is unreadable or too old, or the controller sits
    # refusing the newer state with no word on the screen.
    BB_VERSION="$bbver" python3 "$OPT/scripts/dashboard/stateversion.py" newer "$STATE" >/dev/null 2>&1 || exit 0
fi
if BB_VERSION="$bbver" python3 "$OPT/scripts/dashboard/stateversion.py" check "$STATE" >/dev/null 2>&1; then
    echo "restore-before: this slot reads the configuration as it is: nothing put back"
    exit 0
fi
copy="$WORK/before/${ver:-unknown}.tar.gz"
[ -z "$kept" ] || copy="$WORK/kept/$kept/state.tar.gz"
if [ ! -f "$copy" ]; then
    echo "restore-before: the configuration is newer than this slot reads, and there is no copy from before the update ($copy): the controller will say why it does not start" >&2
    exit 0
fi
aside="$WORK/rolled-back-$(date +%Y%m%d-%H%M%S)"
mkdir -p "$aside"
chmod 0700 "$aside"
tmp="$(dirname "$STATE")/.restore-$$"
rm -rf "${tmp:?}"
mkdir -p "$tmp"
if ! tar -xzf "$copy" -C "$tmp"; then
    rm -rf "${tmp:?}"
    echo "restore-before: $copy did not unpack: nothing put back" >&2
    exit 0
fi
name="$(basename "$STATE")"
[ -d "$tmp/$name" ] || { rm -rf "${tmp:?}"; echo "restore-before: $copy holds no $name: nothing put back" >&2; exit 0; }
# What the copy leaves out (the logs, the jobs) stays with the configuration.
# A RAM disk there (a stick's logs) stays mounted where it is: it moves with the
# folder below, and is put back under the new one after.
moved=()
for keep in logs jobs; do
    [ -e "$STATE/$keep" ] && [ ! -e "$tmp/$name/$keep" ] || continue
    if mountpoint -q "$STATE/$keep"; then
        moved+=("$keep")
    else
        mv "$STATE/$keep" "$tmp/$name/$keep"
    fi
done
mv "$STATE" "$aside/$name"
mv "$tmp/$name" "$STATE"
for keep in "${moved[@]}"; do
    mkdir -p "$STATE/$keep"
    mount --move "$aside/$name/$keep" "$STATE/$keep" || echo "restore-before: $keep did not come across" >&2
done
rm -rf "${tmp:?}"
# A visit's set-aside comes back when the visit ends (above).
[ -z "$kept" ] || [ -s "$MARK" ] || printf '%s\n' "$aside/$name" > "$MARK"
echo "restore-before: the configuration is back to the copy from before the update ($copy); what it held is in $aside/$name"

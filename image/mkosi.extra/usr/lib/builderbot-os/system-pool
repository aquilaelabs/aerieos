#!/usr/bin/env bash
# The system pool of an AerieOS stick (R161 step 10, the operator,
# 29 Oct: the stick read once and written rarely, as Unraid's is): what
# writes all day, docker's and containerd's data, libvirt's, the toolchain
# store and the projects, lives on a pool, bound over its usual place at
# every boot, and the stick keeps the configuration alone. Until a pool is
# named, docker, containerd and libvirt are held (the initramfs's drop-ins
# wait for /run/builderbot-os/system-pool-ready), as Unraid's Docker and VMs
# wait for the array.
#
#   system-pool apply        at boot (builderbot-os-system-pool.service), and
#                            again while the pool is not mounted yet: bind
#                            each folder, then let the held services start
#   system-pool set PATH     name the pool's mount point: the services
#                            stopped, what the stick holds of each moved to
#                            the pool, the name kept, applied, started again
#   system-pool status       one JSON line for the census
#   system-pool projects PATH [NAME...]
#                            name a folder already on the machine's disks
#                            (an adopted share that holds the projects) as
#                            the projects folder: bound over it at every
#                            boot in place of the pool's, its files handed
#                            to the controller's account, the controller
#                            restarted on it; the NAMEs are the projects the
#                            controller knows, each said found or missing
#   system-pool projects --release
#                            let it go: the pool's (or the stick's) again
#
# On a boot that is not a stick's (an installed disk), apply and status say
# so and change nothing: there the data partition is the machine's disk.
set -euo pipefail
WORK="${BB_OS_WORK:-/var/lib/builderbot-os}"
FILE="$WORK/system-pool"
RUN="${BB_OS_RUN:-/run/builderbot-os}"
READY="$RUN/system-pool-ready"
CMDLINE="${BB_CMDLINE:-/proc/cmdline}"
ENVF="${BB_CONTROLLER_ENV:-/etc/builderbot-controller/controller.env}"
SUB="builderbot-system"
SERVICES=(containerd docker libvirtd)
PFILE="$WORK/projects-folder"
CONTROLLER="builderbot-controller"

envget() { sed -n "s/^$1=//p" "$ENVF" 2>/dev/null | tr -d '"' | tail -1; }
projects_place() { local ws; ws="$(envget WORKSPACE)"; printf '%s' "${ws:-/srv/builderbot/projects}"; }
# The folder named as the projects folder, if one is (projects PATH).
named_projects() { [ -s "$PFILE" ] && head -1 "$PFILE"; }
bound() { findmnt -rn -o TARGET "$1" 2>/dev/null | grep -qx "$1"; }
# The projects never on the stick (the operator, 1 Nov): until a system pool
# or a folder on the disks is named, the projects folder is an empty
# read-only mount of its own, held, so nothing can be written there.
HELD="bb-projects-held"
held() { findmnt -rn -o SOURCE "$1" 2>/dev/null | grep -qx "$HELD"; }
hold_projects() {
    local place; place="$(projects_place)"
    mkdir -p "$place"
    held "$place" && return 0
    bound "$place" && return 0
    if [ -z "${BB_SP_NO_MOUNT:-}" ] && ! mount -t tmpfs -o ro,size=64k,mode=0755 "$HELD" "$place" 2>/dev/null; then
        echo "system-pool: the projects folder could not be held read only; the controller still makes no project until they have a place" >&2
        return 0
    fi
    echo "system-pool: the projects are held: none is made on the stick, and they wait for a system pool or a folder on the disks"
}
# A folder made on a pool is as the place it is bound over is, whoever that is
# (the projects and the toolchains are the controller's, not root's, B597).
as_place() {
    [ -n "${BB_SP_NO_MOUNT:-}" ] && return 0
    chown --reference="$2" "$1" 2>/dev/null || true
    chmod --reference="$2" "$1" 2>/dev/null || true
}
# The hold let go before the projects get a real place.
unhold() { held "$1" && umount "$1"; return 0; }
# name=place, each a folder that writes all day; the projects only while no
# folder of the machine's own is named for them.
targets() {
    local sdk
    sdk="$(envget SDK_ROOT)"
    printf '%s\n' "docker=${BB_SP_DOCKER:-/var/lib/docker}" "containerd=${BB_SP_CONTAINERD:-/var/lib/containerd}" \
        "libvirt=${BB_SP_LIBVIRT:-/var/lib/libvirt}" "toolchains=${sdk:-/var/lib/builderbot-controller/sdk}"
    named_projects >/dev/null || printf '%s\n' "projects=$(projects_place)"
}

# The named projects folder bound over the controller's, at every boot and
# whenever it comes up late (an array put together after boot); the
# controller restarted when it was running on what lay underneath.
apply_projects() {
    local f place
    f="$(named_projects || true)"
    [ -n "$f" ] || return 0
    place="$(projects_place)"
    if [ ! -d "$f" ]; then
        # Held meanwhile: nothing written underneath where the disk will be.
        hold_projects
        echo "system-pool: the projects folder $f is not there yet (its disks not mounted): tried again in half a minute" >&2
        return 1
    fi
    mkdir -p "$place"
    unhold "$place"
    if ! bound "$place"; then
        [ -n "${BB_SP_NO_MOUNT:-}" ] || mount --bind "$f" "$place"
        if [ -z "${BB_SP_NO_SYSTEMCTL:-}" ] && systemctl is-active --quiet "$CONTROLLER" 2>/dev/null; then
            systemctl restart --no-block "$CONTROLLER" 2>/dev/null || true
        fi
    fi
    echo "system-pool: the projects are $f"
}
stick() { grep -qw 'bbtoram=1' "$CMDLINE" 2>/dev/null; }
mounted() { [ -n "${BB_SP_MOUNTED:-}" ] && { [ "$BB_SP_MOUNTED" = 1 ]; return; }; findmnt -rn --target "$1" -o TARGET 2>/dev/null | grep -qx "$1"; }
pool() { [ -s "$FILE" ] && head -1 "$FILE"; }
units() { for u in "${SERVICES[@]}"; do systemctl list-unit-files "$u.service" >/dev/null 2>&1 && printf '%s\n' "$u"; done; }

apply() {
    stick || { echo "system-pool: not a stick boot: the data partition is this machine's disk"; return 0; }
    # The projects folder first and on its own: projects need no pool.
    local rc=0
    apply_projects || rc=1
    local p; p="$(pool || true)"
    if [ -z "$p" ]; then
        named_projects >/dev/null || hold_projects
        echo "system-pool: no system pool named yet: docker, containerd and libvirt wait for one (This machine's The stick)"
        return "$rc"
    fi
    if ! mounted "$p"; then
        echo "system-pool: $p is not mounted yet: tried again in half a minute" >&2
        return 1
    fi
    local line name place src
    while IFS= read -r line; do
        name="${line%%=*}"; place="${line#*=}"; src="$p/$SUB/$name"
        mkdir -p "$src" "$place"
        unhold "$place"
        if ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; then
            [ -n "$(ls -A "$src" 2>/dev/null)" ] || as_place "$src" "$place"
        fi
        if ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place"; then
            mount --bind "$src" "$place"
        fi
    done < <(targets)
    mkdir -p "$RUN"; : > "$READY"
    # The held services start now their condition holds; at boot this runs
    # before them, so systemd starts them in order anyway.
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "${SERVICES[@]/%/.service}" 2>/dev/null || true
    echo "system-pool: on $p: $(targets | cut -d= -f1 | paste -sd, -)"
    return "$rc"
}

# projects PATH [NAME...]: an existing folder taken as the projects folder.
set_projects() {
    local f="${1:-}"; shift || true
    stick || { echo "system-pool: only a stick boot takes a projects folder this way" >&2; return 2; }
    case "$f" in /*) ;; *) echo "system-pool: a projects folder is named by its path" >&2; return 2 ;; esac
    case "/$f/" in */../*|*/./*) echo "system-pool: a projects folder is named by its path, with no . or .." >&2; return 2 ;; esac
    [ -d "$f" ] || { echo "system-pool: $f is not a folder on this machine" >&2; return 2; }
    local place src_dev f_dev
    place="$(projects_place)"
    src_dev="$(findmnt -rn -o SOURCE --target "${BB_SP_VAR:-/var}" 2>/dev/null || true)"
    f_dev="$(findmnt -rn -o SOURCE --target "$f" 2>/dev/null || true)"
    if [ -n "$src_dev" ] && [ "$src_dev" = "$f_dev" ]; then
        echo "system-pool: $f is on the stick itself: name a folder on the machine's disks" >&2; return 2
    fi
    case "$f" in "$place"|"$place"/*) echo "system-pool: $f is the projects folder itself" >&2; return 2 ;; esac
    if findmnt -rn -o OPTIONS --target "$f" 2>/dev/null | tr , '\n' | grep -qx ro; then
        echo "system-pool: $f is mounted read only (its disks were adopted read only): adopt them writable first" >&2; return 2
    fi
    # Which of the controller's projects it holds, said before anything moves.
    local n found=0 missing=()
    for n in "$@"; do
        if [ -d "$f/$n" ]; then found=$((found + 1)); else missing+=("$n"); fi
    done
    [ "$#" -eq 0 ] || echo "system-pool: $f holds $found of the controller's $# projects${missing[*]:+; not there: ${missing[*]}}"
    # Its files handed to the controller's account, as a projects folder it
    # made is: another system's (uid 99, say) is refused by git as dubious
    # and cannot be written. Nothing in them changes but their owner.
    local acct grp
    acct="$(envget BB_ACCOUNT)"; acct="${acct:-builderbot}"
    grp="$(id -gn "$acct" 2>/dev/null || true)"
    if [ -z "${BB_SP_NO_MOUNT:-}" ]; then
        id "$acct" >/dev/null 2>&1 || { echo "system-pool: no account $acct here to hand the folder to" >&2; return 2; }
        echo "system-pool: handing $f to $acct (its files' owner alone)"
        chown -R "$acct${grp:+:$grp}" "$f"
        # The top closed to others: the wall refuses every session on this
        # machine while anybody can walk into the projects (B596).
        chmod 0750 "$f"
    fi
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl stop "$CONTROLLER" 2>/dev/null || true
    if bound "$place" && [ -z "${BB_SP_NO_MOUNT:-}" ] && ! umount "$place"; then
        echo "system-pool: $place is busy and stays as it is: close what holds it and name the folder again" >&2
        [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
        return 1
    fi
    # What lay in the projects folder before stays where it was, under the
    # bind, never deleted: letting the folder go shows it again.
    [ -n "$(ls -A "$place" 2>/dev/null)" ] && echo "system-pool: what $place held before stays underneath, unseen while $f is the projects folder"
    mkdir -p "$WORK"
    printf '%s\n' "$f" > "$PFILE.new"; mv -f "$PFILE.new" "$PFILE"
    apply_projects
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
}

# projects --release: the folder let go, the pool's projects (or the
# stick's) bound again; the folder itself and its files stay as they are.
release_projects() {
    local place f
    place="$(projects_place)"; f="$(named_projects || true)"
    [ -n "$f" ] || { echo "system-pool: no projects folder is named"; return 0; }
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl stop "$CONTROLLER" 2>/dev/null || true
    if bound "$place" && [ -z "${BB_SP_NO_MOUNT:-}" ] && ! umount "$place"; then
        echo "system-pool: $place is busy: close what holds it and let it go again" >&2
        [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
        return 1
    fi
    rm -f "$PFILE"
    echo "system-pool: $f is no longer the projects folder; its files stay where they are"
    local p; p="$(pool || true)"
    if [ -n "$p" ] && mounted "$p" && [ -z "${BB_SP_NO_MOUNT:-}" ]; then
        mkdir -p "$p/$SUB/projects"
        mount --bind "$p/$SUB/projects" "$place"
    elif [ -z "$p" ]; then
        hold_projects
    fi
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "$CONTROLLER" 2>/dev/null || true
}

set_pool() {
    local p="${1:-}"
    stick || { echo "system-pool: only a stick boot takes a system pool" >&2; return 2; }
    case "$p" in /*) ;; *) echo "system-pool: a pool is named by its mount point" >&2; return 2 ;; esac
    mounted "$p" || { echo "system-pool: $p is not a mounted pool" >&2; return 2; }
    local var_src p_src
    var_src="$(findmnt -rn -o SOURCE --target "${BB_SP_VAR:-/var}" 2>/dev/null || true)"
    p_src="$(findmnt -rn -o SOURCE --target "$p" 2>/dev/null || true)"
    if [ -n "$var_src" ] && [ "$var_src" = "$p_src" ]; then
        echo "system-pool: $p is on the stick itself: name a pool on the machine's disks" >&2; return 2
    fi
    [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl stop "${SERVICES[@]/%/.service}" 2>/dev/null || true
    local line name place src
    while IFS= read -r line; do
        name="${line%%=*}"; place="${line#*=}"; src="$p/$SUB/$name"
        mkdir -p "$src"
        if findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place" && ! umount "$place"; then
            # Still the old pool's: a copy and a delete through it would
            # empty that pool (B476). Nothing more moves; what moved stays.
            echo "system-pool: $place is busy and stays where it is: close what holds it and set the pool again" >&2
            [ -n "${BB_SP_NO_SYSTEMCTL:-}" ] || systemctl start --no-block "${SERVICES[@]/%/.service}" 2>/dev/null || true
            return 1
        fi
        [ -n "$(ls -A "$src" 2>/dev/null)" ] || as_place "$src" "$place"
        # What the stick holds of it goes to the pool once, then off the stick.
        if [ -d "$place" ] && [ -n "$(ls -A "$place" 2>/dev/null)" ]; then
            cp -a "$place/." "$src/"
            find "$place" -mindepth 1 -delete
        fi
    done < <(targets)
    mkdir -p "$WORK"
    printf '%s\n' "$p" > "$FILE.new"; mv -f "$FILE.new" "$FILE"
    apply
}

status() {
    local p ready=false on_stick=() kb="" since="" dev line name place
    stick || { echo '{"stick": false}'; return 0; }
    p="$(pool || true)"
    [ -e "$READY" ] && ready=true
    while IFS= read -r line; do
        name="${line%%=*}"; place="${line#*=}"
        if ! findmnt -rn -o TARGET "$place" 2>/dev/null | grep -qx "$place" && [ -n "$(ls -A "$place" 2>/dev/null)" ]; then
            on_stick+=("\"$name\"")
        fi
    done < <(targets)
    dev="$(basename "$(findmnt -rn -o SOURCE --target "${BB_SP_VAR:-/var}" 2>/dev/null || true)")"
    [ -n "$dev" ] && [ -r "/sys/fs/ext4/$dev/lifetime_write_kbytes" ] && kb="$(cat "/sys/fs/ext4/$dev/lifetime_write_kbytes")"
    [ -n "$dev" ] && [ -r "/sys/fs/ext4/$dev/session_write_kbytes" ] && since="$(cat "/sys/fs/ext4/$dev/session_write_kbytes")"
    local IFS=,
    local pf home; pf="$(named_projects || true)"
    # Where the projects are: a named folder on the disks, the pool's, or
    # held (nowhere yet: never the stick).
    if [ -n "$pf" ]; then home="folder"; elif [ -n "$p" ] && [ "$ready" = true ]; then home="pool"; else home="held"; fi
    printf '{"stick": true, "pool": "%s", "ready": %s, "on_stick": [%s], "written_kb": %s, "boot_written_kb": %s, "projects": "%s", "projects_bound": %s, "projects_home": "%s"}\n' \
        "${p//\"/}" "$ready" "${on_stick[*]}" "${kb:-null}" "${since:-null}" "${pf//\"/}" \
        "$( { [ -n "$pf" ] && bound "$(projects_place)" && ! held "$(projects_place)"; } && echo true || echo false)" "$home"
}

case "${1:-}" in
    apply) apply ;;
    set) set_pool "${2:-}" ;;
    projects)
        if [ "${2:-}" = --release ]; then release_projects; else shift; set_projects "$@"; fi ;;
    status) status ;;
    *) echo "usage: system-pool apply | set PATH | projects PATH [NAME...] | projects --release | status" >&2; exit 64 ;;
esac

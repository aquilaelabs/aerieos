#!/bin/bash
# Runs inside the image's root once its packages are in (mkosi.postinst):
# the controller staged from the checkout the way a bare-metal install lays
# it out, and the two things an immutable root changes about Debian.
set -euo pipefail
SRC=/work/src/aerieos
[ -d "$SRC/nodes" ] || { echo "mkosi.postinst: the checkout is not at $SRC (BuildSources)" >&2; exit 1; }

# The controller: its account, release, env file, bb, sudo rule and service,
# enabled and not started; the node half runs at the first boot
# (aerieos-os-firstboot.service, install-controller.sh --firstboot).
mkosi-chroot env "BB_STAGE_VERSION=${BUILDERBOT_OS_VERSION:-}" "BB_STAGE_REV=${BUILDERBOT_OS_REV:-}" \
    bash "$SRC/nodes/install-controller.sh" --stage --docker

# apt is not for a root that forgets: diverted, a stub in its place says why
# and where a tool comes from instead (usr/lib/aerieos-os/no-apt).
for t in apt apt-get; do
    mkosi-chroot dpkg-divert --quiet --divert "/usr/bin/$t.distrib" --rename "/usr/bin/$t"
    mkosi-chroot ln -sfn /usr/lib/aerieos-os/no-apt "/usr/bin/$t"
done

# The ESP's mount point, and the services the image starts on every boot:
# the controller (enabled by --stage), docker and libvirt for the node, the
# network and the time.
mkosi-chroot install -d -m 0700 /boot/efi
mkosi-chroot systemctl enable systemd-networkd systemd-resolved systemd-timesyncd docker libvirtd >/dev/null 2>&1 || true
# NUT's services stay off until the UPS feature is turned on, which
# enables them with the config it writes: started with none, its monitor
# ends as a failed unit on every machine without a UPS.
mkosi-chroot systemctl disable nut-server.service nut-monitor.service nut-driver-enumerator.service nut-driver-enumerator.path nut-driver.target nut.target >/dev/null 2>&1 || true
# AerieOS's own units, enabled here rather than as links in the extra
# tree (a symlink in the repository does not travel with the tree, B417):
# the first boot, the installer, which its condition keeps to the ISO, and
# the health check that marks a trial slot good.
mkosi-chroot systemctl enable aerieos-os-firstboot.service aerieos-os-installer.service aerieos-os-health.service aerieos-os-env.service aerieos-os-system-pool.service aerieos-os-restore.service
# Every interface takes DHCP until the Network page says otherwise (R165
# step 4's bare-metal half).
mkosi-chroot install -d -m 0755 /etc/systemd/network
cat > "$BUILDROOT/etc/systemd/network/80-dhcp.network" <<'NET'
[Match]
Name=en* eth*

[Network]
DHCP=yes
NET

# Docker told of the NVIDIA runtime (R207): the toolkit's own tool writes
# /etc/docker/daemon.json, so a container asking for the card
# (gpus: all) gets it on a machine with one; on one without, the runtime
# is named and never used.
mkosi-chroot nvidia-ctk runtime configure --runtime=docker >/dev/null

# libvirt's network sockets: nothing here uses them, and the TLS one activates
# libvirtd with no certificates, which then fails at every boot after the first
# and takes the local socket down with it (B674).
mkosi-chroot systemctl mask libvirtd-tls.socket libvirtd-tcp.socket >/dev/null 2>&1

# Debian's driver lists nvidia-drm for every boot, which fails the boot's module
# load on a machine with no card; udev loads it where a card is instead
# (71-aerieos-nvidia.rules).
rm -f "$BUILDROOT/etc/modules-load.d/nvidia.conf"

# The initramfs again, now that the extra tree put the init-bottom script
# and the modules list in (the kernel's own install ran before them).
mkosi-chroot update-initramfs -u -k all

{
 "about": "The .NET SDK plus the maui-android workload: Android apps from C#.",
 "format": 5,
 "framework": "5.1",
 "label": ".NET + MAUI",
 "layout": {
  "bin": [
   "",
   "tools"
  ],
  "env": {
   "DOTNET_ROOT": ""
  },
  "tool": "dotnet"
 },
 "maker": "Microsoft",
 "name": "dotnet",
 "platforms": [
  "linux/*"
 ],
 "shipped": {
  "probe": "dotnet",
  "reports": "dotnet",
  "rev": 3,
  "source": {
   "checksum": {
    "from": "pin",
    "sha256": {
     "linux-musl/amd64": "f8f983bc1f784a5e4d3eec83cd70878a590c8328cd25a6d94ac8d43cd50f8c46",
     "linux-musl/arm64": "e4dae17cbf0c26afb05eda8c2f5365ab291cf32ffd7c115fc0525a9cba268d30",
     "linux/amd64": "c0610757a818fde4b960d27a0ac421f273068a05dc5ec7abafc01dbf84e9cb4d",
     "linux/arm64": "dcc820a4277ab6bb3f648c609d86f2a7912ba9a3d166545e7b95dff419c12f0f"
    },
    "version": "10.0.404"
   },
   "kind": "tarball",
   "online": "dotnet downloads the maui-android workload from api.nuget.org",
   "then": [
    {
     "env": {
      "DOTNET_CLI_TELEMETRY_OPTOUT": "1",
      "DOTNET_ROOT": "{dir}"
     },
     "note": "adding the maui-android workload (android targets from C#)",
     "optional": "the maui-android workload failed; the plain SDK is still installed",
     "run": [
      "{dir}/dotnet",
      "workload",
      "install",
      "maui-android"
     ]
    }
   ],
   "url": {
    "linux-musl/amd64": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-musl-x64.tar.gz",
    "linux-musl/arm64": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-musl-arm64.tar.gz",
    "linux/amd64": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-x64.tar.gz",
    "linux/arm64": "https://builds.dotnet.microsoft.com/dotnet/Sdk/{version}/dotnet-sdk-{version}-linux-arm64.tar.gz"
   },
   "version": {
    "resolver": "text",
    "url": "https://builds.dotnet.microsoft.com/dotnet/Sdk/LTS/latest.version"
   }
  },
  "system": {
   "apk": [
    "icu-libs"
   ],
   "apt": [
    "libicu78|libicu76|libicu74|libicu72|libicu70"
   ],
   "dnf": [
    "libicu"
   ],
   "emerge": [
    "dev-libs/icu"
   ],
   "pacman": [
    "icu"
   ],
   "xbps": [
    "icu"
   ],
   "zypper": [
    "libicu78|libicu73_2|libicu69|libicu-suse65_1"
   ]
  },
  "updatable": true
 },
 "terms": [
  {
   "label": ".NET SDK (MIT)",
   "url": "https://github.com/dotnet/sdk/blob/main/LICENSE.TXT"
  },
  {
   "label": ".NET MAUI (MIT)",
   "url": "https://github.com/dotnet/maui/blob/main/LICENSE.txt"
  }
 ],
 "tier": "official"
}

{
 "about": "OpenCode, run by sessions as opencode",
 "agent": {
  "briefing": "instructions-file",
  "command": "opencode",
  "guards": "plugin",
  "install": {
   "also": [
    ".local/bin/opencode"
   ],
   "bin": ".opencode/bin/opencode",
   "env": {},
   "fetch": [
    {
     "sha256": "a2dd59522b9a091b6cdb2e4870c0f2135f7da09807cd5a7e04222d4316925b72",
     "to": "dl/install",
     "track": {
      "repo": "anomalyco/opencode",
      "resolver": "github-release",
      "trim_prefix": "v"
     },
     "url": "https://raw.githubusercontent.com/anomalyco/opencode/v{version}/install",
     "version": "1.19.6"
    }
   ],
   "fresh": "",
   "online": "Its installer downloads the OpenCode build for this machine from github.com/anomalyco/opencode's releases, and checks it against nothing.",
   "pin": [
    "VERSION",
    "{v}"
   ],
   "rev": 2,
   "steps": [
    [
     "bash",
     "{dir}/dl/install",
     "--no-modify-path"
    ]
   ]
  },
  "latest_url": "https://registry.npmjs.org/opencode-ai/latest",
  "login_job": "",
  "logout_job": "",
  "product": "OpenCode",
  "provider": "",
  "reported": "opencode",
  "state": "plugin",
  "tool": "opencode",
  "transcripts": ".local/share/opencode",
  "update_job": "opencode-update"
 },
 "format": 5,
 "framework": "5.1",
 "label": "Any model",
 "maker": "Anomaly",
 "name": "open",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}

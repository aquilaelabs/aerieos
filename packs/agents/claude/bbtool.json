{
 "about": "Claude Code, run by sessions as claude",
 "agent": {
  "allow": {
   "how": "settings",
   "rule": "Bash({cmd} *)"
  },
  "briefing": "system-prompt-file",
  "command": "claude",
  "guards": "hooks",
  "install": {
   "also": [
    ".local/share/claude"
   ],
   "bin": ".local/bin/claude",
   "env": {},
   "fetch": [
    {
     "sha256": "2c5506d110560bf618bbe88f678f2c2a0047c86a9c6585fc84976120b1de0b44",
     "to": "dl/install.sh",
     "url": "https://claude.ai/install.sh"
    }
   ],
   "fresh": ".local/share/claude/versions/{v}",
   "online": "Its installer downloads the Claude Code program for this machine from downloads.claude.ai and checks it against the sha256 that release's manifest states; the program then sets up its own launcher.",
   "pin": null,
   "rev": 2,
   "steps": [
    [
     "bash",
     "{dir}/dl/install.sh"
    ]
   ]
  },
  "latest_url": "",
  "login_job": "claude-login",
  "logout_job": "claude-logout",
  "product": "Claude Code",
  "provider": "Anthropic",
  "reported": "claude",
  "signin": {
   "flow": {
    "ends": "exit",
    "kept": ".claude/.credentials.json",
    "logout": [
     "claude",
     "auth",
     "logout"
    ],
    "prompt": "Paste code",
    "refused": "Invalid code",
    "url": [
     "https://claude.com/",
     "https://console.anthropic.com/",
     "https://platform.claude.com/"
    ],
    "who": {
     "email": [
      "oauthAccount",
      "emailAddress"
     ],
     "file": ".claude.json"
    }
   },
   "login": [
    "claude",
    "auth",
    "login"
   ]
  },
  "state": "hooks",
  "tool": "claude-code",
  "transcripts": ".claude/projects",
  "update_job": "claude-update"
 },
 "format": 5,
 "framework": "5.2",
 "label": "Claude",
 "maker": "Anthropic",
 "name": "claude",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}

{
 "about": "Codex CLI, run by sessions as codex",
 "agent": {
  "allow": {
   "file": ".codex/rules/aerieos.rules",
   "how": "rules-file",
   "rule": "prefix_rule(pattern={argv}, decision=\"allow\")"
  },
  "briefing": "instructions-file",
  "command": "codex",
  "guards": "hooks",
  "install": {
   "also": [],
   "bin": ".local/bin/codex",
   "env": {
    "CODEX_INSTALL_DIR": "{home}/.local/bin"
   },
   "fetch": [
    {
     "found": {
      "from": "github-asset"
     },
     "sha256": "b698d8eb50c0fbe0214ea57b5bf2af439054108404c6d2b872989db02f4bd574",
     "to": "dl/install.sh",
     "track": {
      "repo": "openai/codex",
      "resolver": "github-release",
      "trim_prefix": "rust-v"
     },
     "url": "https://github.com/openai/codex/releases/download/rust-v{version}/install.sh",
     "version": "0.171.0"
    }
   ],
   "fresh": "",
   "online": "Its installer downloads the Codex CLI package for this machine from releases.openai.com or github.com/openai/codex's releases, and checks it against the sha256 GitHub states for that release.",
   "pin": [
    "CODEX_RELEASE",
    "{v}"
   ],
   "rev": 2,
   "steps": [
    [
     "sh",
     "{dir}/dl/install.sh"
    ]
   ]
  },
  "latest_url": "https://registry.npmjs.org/@openai/codex/latest",
  "login_job": "codex-login",
  "logout_job": "codex-logout",
  "product": "Codex CLI",
  "provider": "OpenAI",
  "reported": "codex",
  "signin": {
   "flow": {
    "code_after": "Enter this one-time code",
    "ends": "exit",
    "kept": ".codex/auth.json",
    "logout": [
     "codex",
     "logout"
    ],
    "url": "https://auth.openai.com/",
    "who": {
     "email": [
      "tokens",
      "id_token",
      "email"
     ],
     "key": [
      "OPENAI_API_KEY"
     ],
     "key_named": "an OpenAI API key",
     "plan": [
      "tokens",
      "id_token",
      "https://api.openai.com/auth",
      "chatgpt_plan_type"
     ]
    }
   },
   "login": [
    "codex",
    "login",
    "--device-auth"
   ]
  },
  "state": "hooks",
  "tool": "codex-cli",
  "transcripts": ".codex/sessions",
  "update_job": "codex-update"
 },
 "format": 5,
 "framework": "5.2",
 "label": "ChatGPT",
 "maker": "OpenAI",
 "name": "codex",
 "platforms": [
  "linux/*"
 ],
 "terms": [],
 "tier": "official"
}

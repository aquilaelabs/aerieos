  "label": "Heron",
  "about": "The Heron schema compiler: turns a schema file into typed readers and writers for it.",
  "format": 5,
  "framework": "5.2",
  "maker": "Heron Schema Authors",
  "platforms": ["linux/amd64", "linux/arm64"],
  "terms": [{"label": "Heron (MIT)", "url": "https://github.com/heron-schema/heron/blob/main/LICENSE"}],
  "install": {
    "fetch": [
      {"url": "https://github.com/heron-schema/heron/releases/download/v{version}/heron-{version}-linux-x64.tar.gz",

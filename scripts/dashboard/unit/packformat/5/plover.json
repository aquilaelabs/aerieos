      {"url": "https://files.pythonhosted.org/packages/6e/2a/0c9b8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a/fastcsv-1.9.2-cp312-cp312-manylinux_2_28_aarch64.whl",

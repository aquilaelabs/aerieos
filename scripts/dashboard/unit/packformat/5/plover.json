      {"url": "https://files.pythonhosted.org/packages/91/0e/2b7d4c6a8e1f3b5d7c9a0e2f4b6d8c1a3e5f7b9d0c2e4a6f8b1d3c5e7a9f/et_xmlfile-2.0.0-py3-none-any.whl",

#!/usr/bin/env bash
#
# Root-only helper that carries the controller's secrets folder across a move
# or a backup on a machine of its own, where the folder is root's and the
# dashboard's account can neither read it nor write into it: its *.env files
# and the keys under ssh/, never the install key's folder, which travels by
# its own tick.
#
# The controller's account may run exactly this script via sudo (the rule
# install-controller.sh writes); a coding agent's session runs as another
# account, which may not, and the move it serves is the owner's alone.
#
#   secrets-carry --can    "N files, B bytes" when there is something to carry; exit 3 when not
#   secrets-carry pack     the *.env files and ssh/ keys as a tar on stdout
#   secrets-carry land     a tar read on stdin put into the folder, each file held to its shape
#
# What `land` takes is data, never code, since the controller's start reads
# every *.env here as root: a line is kept only as NAME='value' for a NAME
# the start reads as a secret (lib/boot.sh SECRET_VARS) and a value with no
# shell in it, written out again quoted; any other line is left out and
# named. A key under ssh/ is a plain file, loaded by ssh-add or not at all.
# A file already here of the same name is kept beside the new one, as
# NAME.before-move, which nothing reads.
set -euo pipefail

HERE="$(dirname "$(readlink -f "$0")")"
# shellcheck source=lib/common.sh
. "$HERE/lib/common.sh"

# The names a *.env file here may set: lib/boot.sh SECRET_VARS, held to it
# by unit/test_secrets_carry.py.
SECRET_NAMES=(NPM_TOKEN UV_PUBLISH_TOKEN INSTALL_KEY INSTALL_KEY_PREVIOUS SIGNING_SECRET)
NAME_RE='^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$'
MAX_BYTES=$((4 * 1024 * 1024))
MAX_KEY_BYTES=$((64 * 1024))

# The folder: the controller's own env file names it (root's, as
# bb_root_state reads the state's place), else where a machine of its own
# keeps it. A caller that is not root may name another, which a test does:
# sudo hands root no such word.
secrets_dir() {
    local f="${BB_CONTROLLER_ENV:-}" v="" mode
    if [ "$(id -u)" -ne 0 ] && [ -n "${BB_SECRETS_DIR:-}" ]; then
        printf '%s' "$BB_SECRETS_DIR"; return 0
    fi
    if [ -n "$f" ] && [ -f "$f" ] && [ "$(stat -c %u "$f" 2>/dev/null)" = 0 ]; then
        mode="$(stat -c %a "$f" 2>/dev/null || echo 777)"
        if [ $(( 8#$mode & 8#022 )) -eq 0 ]; then
            v="$(sed -n 's/^BB_SECRETS_DIR=//p' "$f" | tail -1)"; v="${v//\"/}"
        fi
    fi
    case "$v" in /*) printf '%s' "$v" ;; *) printf '/etc/aerieos-controller/secrets' ;; esac
}

# The files a bundle carries, one a line, relative to the folder: its *.env
# files and the plain files under ssh/, no link among them.
carried() {
    local f
    for f in ./*.env; do
        [ -f "$f" ] && [ ! -L "$f" ] && [[ "${f#./}" =~ $NAME_RE ]] && printf '%s\n' "${f#./}"
    done
    if [ -d ssh ] && [ ! -L ssh ]; then
        for f in ssh/*; do
            [ -f "$f" ] && [ ! -L "$f" ] && [[ "${f#ssh/}" =~ $NAME_RE ]] && printf '%s\n' "$f"
        done
    fi
    return 0
}

is_secret_name() {
    local n
    for n in "${SECRET_NAMES[@]}"; do [ "$n" = "$1" ] && return 0; done
    return 1
}

# One *.env file's lines kept as NAME='value', on stdout; what is left out
# is said on stderr. Returns 1 when nothing is kept.
env_lines() {
    local file="$1" shown="$2" line name val n=0 kept=0 q="'"
    while IFS= read -r line || [ -n "$line" ]; do
        n=$((n + 1))
        line="${line%$'\r'}"
        [[ "$line" =~ ^[[:space:]]*(#.*)?$ ]] && continue
        if [[ "$line" =~ ^[[:space:]]*(export[[:space:]]+)?([A-Za-z_][A-Za-z0-9_]*)=(.*)$ ]]; then
            name="${BASH_REMATCH[2]}"; val="${BASH_REMATCH[3]}"
            if ! is_secret_name "$name"; then
                echo "left out of $shown: line $n sets $name, which is not a secret the controller's start reads" >&2; continue
            fi
            # The value as a literal: bare with nothing a shell would read
            # into, or inside one pair of quotes with nothing that expands.
            if [[ "$val" =~ ^\'([^\']*)\'[[:space:]]*$ ]]; then
                val="${BASH_REMATCH[1]}"
            elif [[ "$val" =~ ^\"([^\"\$\`\\]*)\"[[:space:]]*$ ]]; then
                val="${BASH_REMATCH[1]}"
            elif [[ "$val" =~ ^[A-Za-z0-9_@%+=:,./~-]*$ ]]; then
                :
            else
                echo "left out of $shown: line $n ($name) has shell in its value; copy that one by hand, as root" >&2; continue
            fi
            printf '%s=%s%s%s\n' "$name" "$q" "$val" "$q"
            kept=$((kept + 1))
        else
            echo "left out of $shown: line $n is not a NAME=value line" >&2
        fi
    done < "$file"
    [ "$kept" -gt 0 ]
}

put() {    # put SRC DEST: root's alone, an older file of the name kept beside it
    local src="$1" dest="$2"
    if [ -e "$dest" ] || [ -L "$dest" ]; then mv -f "$dest" "$dest.before-move"; fi
    install -m 0600 "$src" "$dest"
    [ "$(id -u)" -ne 0 ] || chown root:root "$dest"
}

kind="${1:-}"
case "$kind" in --can|pack|land) ;; *) die "usage: secrets-carry --can | pack | land" ;; esac
dir="$(secrets_dir)"

if [ "$kind" = land ]; then
    tmp="$(mktemp -d)"
    trap 'rm -rf "$tmp"' EXIT
    head -c "$((MAX_BYTES + 1))" > "$tmp/in.tar"
    [ "$(stat -c %s "$tmp/in.tar")" -le "$MAX_BYTES" ] || die "what was handed over is over 4 MB, which no secrets folder is: nothing placed"
    # Every member a plain file of a name this takes, or one of the two
    # folders: a link, a device or a path leading anywhere else refuses it
    # all. The names as tar lists them alone, the kinds from its long list,
    # line for line, so a name with a space in it cannot pass as its last word.
    if ! tar -tf "$tmp/in.tar" > "$tmp/names" 2>/dev/null || ! tar -tvf "$tmp/in.tar" > "$tmp/rows" 2>/dev/null; then
        die "what was handed over is not a tar: nothing placed"
    fi
    mapfile -t names < "$tmp/names"
    mapfile -t rows < "$tmp/rows"
    [ "${#names[@]}" = "${#rows[@]}" ] || die "what was handed over could not be read line for line: nothing placed"
    for i in "${!names[@]}"; do
        type="${rows[i]:0:1}"; name="${names[i]#./}"; name="${name%/}"
        case "$type" in
            d) case "$name" in ""|.|ssh) ;; *) die "what was handed over holds the folder $name, which is not the secrets' shape: nothing placed" ;; esac ;;
            -) if [[ "$name" == ssh/* ]]; then
                   [[ "${name#ssh/}" =~ $NAME_RE ]] || die "what was handed over holds $name, which is not a key's name: nothing placed"
               else
                   { [[ "$name" =~ $NAME_RE ]] && [[ "$name" == *.env ]]; } || die "what was handed over holds $name, which is neither a .env file nor under ssh/: nothing placed"
               fi ;;
            *) die "what was handed over holds $name, which is not a plain file: nothing placed" ;;
        esac
    done
    mkdir "$tmp/x"
    tar -xf "$tmp/in.tar" -C "$tmp/x" --no-same-owner --no-same-permissions
    # Made only where missing: install -d sets a folder's mode even when it
    # is there, and this one's lets the controller's account through to its key.
    [ -d "$dir" ] || install -d -m 0700 "$dir" 2>/dev/null || true
    { [ -d "$dir" ] && [ -w "$dir" ]; } || die "$dir cannot be written here: nothing placed"
    placed=0
    for f in "$tmp/x"/*.env; do
        [ -f "$f" ] && [ ! -L "$f" ] || continue
        base="$(basename "$f")"
        { printf '# Landed by a move on %s (secrets-carry): NAME=value lines the start reads as secrets, written out as plain words.\n' "$(date -u +%Y-%m-%d)"
          env_lines "$f" "$base"; } > "$tmp/out.env" 2> "$tmp/said" && ok=1 || ok=0
        sed 's/^/secrets-carry: /' "$tmp/said"
        if [ "$ok" = 1 ]; then
            put "$tmp/out.env" "$dir/$base"
            echo "secrets-carry: placed $base ($(grep -c "^[A-Z_]*='" "$tmp/out.env") secret(s))"
            placed=$((placed + 1))
        else
            echo "secrets-carry: $base held no secret the start reads, so it was not placed"
        fi
    done
    if [ -d "$tmp/x/ssh" ]; then
        [ -d "$dir/ssh" ] || install -d -m 0700 "$dir/ssh"
        for f in "$tmp/x/ssh"/*; do
            [ -f "$f" ] && [ ! -L "$f" ] || continue
            base="$(basename "$f")"
            if [ "$(stat -c %s "$f")" -gt "$MAX_KEY_BYTES" ]; then
                echo "secrets-carry: ssh/$base is over 64 KB, which no key is, so it was not placed"; continue
            fi
            put "$f" "$dir/ssh/$base"
            echo "secrets-carry: placed ssh/$base"
            placed=$((placed + 1))
        done
    fi
    echo "secrets-carry: $placed file(s) placed in $dir; the controller reads them at its next start"
    exit 0
fi

[ -d "$dir" ] || { echo "secrets-carry: no secrets folder at $dir" >&2; exit 3; }
cd "$dir"
mapfile -t files < <(carried)
[ "${#files[@]}" -gt 0 ] || { echo "secrets-carry: nothing to carry in $dir" >&2; exit 3; }
if [ "$kind" = --can ]; then
    bytes=0
    for f in "${files[@]}"; do bytes=$((bytes + $(stat -c %s "$f"))); done
    echo "${#files[@]} files, $bytes bytes"
    exit 0
fi
tar -cf - --owner=0 --group=0 --no-recursion -- "${files[@]}"

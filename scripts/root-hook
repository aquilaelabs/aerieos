#!/usr/bin/env bash
#
# Root-only helper that keeps which root startup hooks an administrator has
# approved (B1166). A hook in the state's startup.d named *.root.sh runs as
# root at every start, and the dashboard's own account can write that folder,
# so such a hook runs only once an administrator approved that exact file:
# its name and sha256 kept here, in a folder and a file only root writes. A
# file written there later, or the same name changed, waits for approval
# again. The builder user may run exactly this script via sudo; the
# dashboard calls it from Controller settings, Startup hooks, for a person
# with Controller Write, and the start asks `check` before it runs a hook.
#
# What this cannot stop is a shell running as the dashboard's own account,
# which can call it too: a shell on the controller is an administrator's
# alone for that reason (server.py _term_decide). What it stops is a file
# put there by anything that is not the dashboard: another container sharing
# the user id, a network share of the app's folder, a copy restored by hand.
#
#   root-hook list              NAME SHA256 approved|changed|new, one a line
#   root-hook approve NAME SHA  approve NAME as it is now, when its sha256 is SHA
#   root-hook revoke NAME       take NAME's approval back
#   root-hook check NAME        exit 0 when NAME may run as it is now
#
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib/common.sh"
# The state named by the caller is the unit tests' own, which run as nobody's
# root; sudo hands this script none of its caller's environment.
STATE="${BB_ROOT_HOOK_STATE:-$(bb_root_state)}"
HOOKS="$STATE/startup.d"
DIR="$STATE/.root"
LIST="$DIR/hooks.approved"
ME="$(id -u)"

die() { printf 'root-hook: %s\n' "$*" >&2; exit 1; }

# Root's own, and nobody else's to write: a folder the dashboard's account
# renamed into this one's place is that account's, and so not trusted.
trusted() {
    local p="$1" m
    [ -e "$p" ] && [ ! -L "$p" ] || return 1
    [ "$(stat -c %u "$p")" = "$ME" ] || return 1
    m="$(stat -c %a "$p")"
    [ $(( 8#$m & 8#022 )) -eq 0 ]
}

name_ok() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,80}\.root\.sh$ ]]; }

# A hook is a plain file in the folder itself, never a link out of it.
hook_sha() {
    local f="$HOOKS/$1"
    [ -f "$f" ] && [ ! -L "$f" ] || return 1
    sha256sum "$f" | cut -d' ' -f1
}

approved_sha() {
    trusted "$DIR" && trusted "$LIST" || return 0
    awk -v n="$1" '$2 == n { print $1 }' "$LIST" | tail -1
}

own_dir() {
    if [ -e "$DIR" ] && ! trusted "$DIR"; then
        mv "$DIR" "$DIR.untrusted-$(date +%s)"
    fi
    install -d -m 0755 "$DIR"
    if [ -e "$LIST" ] && ! trusted "$LIST"; then
        mv "$LIST" "$LIST.untrusted-$(date +%s)"
    fi
}

# The list written whole beside itself and moved into place: NAME's line
# replaced by `line`, or taken out when there is none.
write_list() {
    local name="$1" line="${2:-}" tmp
    own_dir
    tmp="$(mktemp "$DIR/.hooks.XXXXXX")"
    { [ -f "$LIST" ] && awk -v n="$name" '$2 != n' "$LIST" || true; [ -n "$line" ] && printf '%s\n' "$line"; } > "$tmp"
    chmod 0644 "$tmp"
    mv -f "$tmp" "$LIST"
}

case "${1:-}" in
    list)
        [ -d "$HOOKS" ] || exit 0
        for f in "$HOOKS"/*.root.sh; do
            [ -e "$f" ] || continue
            n="$(basename "$f")"
            name_ok "$n" || continue
            sha="$(hook_sha "$n" || true)"
            [ -n "$sha" ] || continue
            ok="$(approved_sha "$n")"
            if [ "$ok" = "$sha" ]; then s=approved; elif [ -n "$ok" ]; then s=changed; else s=new; fi
            printf '%s %s %s\n' "$n" "$sha" "$s"
        done
        ;;
    approve)
        n="${2:-}" want="${3:-}"
        name_ok "$n" || die "not a root hook's name: $n"
        [[ "$want" =~ ^[0-9a-f]{64}$ ]] || die "approve NAME SHA256"
        sha="$(hook_sha "$n")" || die "$n is not a file in startup.d"
        [ "$sha" = "$want" ] || die "$n changed since it was shown: look at it again"
        write_list "$n" "$sha $n"
        printf 'approved %s %s\n' "$n" "$sha"
        ;;
    revoke)
        n="${2:-}"
        name_ok "$n" || die "not a root hook's name: $n"
        write_list "$n"
        printf 'revoked %s\n' "$n"
        ;;
    check)
        n="${2:-}"
        name_ok "$n" || exit 1
        sha="$(hook_sha "$n")" || exit 1
        [ -n "$sha" ] && [ "$(approved_sha "$n")" = "$sha" ]
        ;;
    *)
        die "list | approve NAME SHA256 | revoke NAME | check NAME"
        ;;
esac

#!/usr/bin/env bash
#
# Root-only helper that keeps the deploy keys made or pasted in a project's
# settings, and loads them into the shielded ssh-agent, so the unprivileged
# `builder` user (and any Claude session running as it) can push with a key
# and never read it. The keys an operator drops into /secrets/ssh by hand
# are loaded beside these at boot, and nothing here touches them.
#
# The builder user may run exactly this script via sudo (the image's sudoers
# rule). A private key comes in on stdin once; every verb prints the public
# half at most.
#
# A key is kept sealed under the install key, as the controller's own
# secrets are (lib/sealfile.py, dashboard/signing.py): NAME.sealed beside
# NAME.pub, opened only into the agent. It was a plain key file with no
# passphrase, guarded by its mode alone, so a copy of /config taken as root
# carried every deploy key ready to use (R243). A plain one from before is
# sealed the first time this loads the keys, at the next start. Where the
# install has no install key, or no way to seal, a key is kept plain as it
# was and that is said.
#
#   deploy-key make NAME     make an ed25519 key called NAME, load it, print its public half
#   deploy-key store NAME    keep the private key read on stdin as NAME, load it, print its public half
#   deploy-key forget NAME   unload NAME and remove it
#   deploy-key --list        NAME per kept key, one per line
#   deploy-key --load        seal what is still plain, then load every kept key into the agent (boot)
#   deploy-key --reseal      seal again, under today's install key, every key sealed under the one before
#
set -euo pipefail

HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
. "$HERE/lib/common.sh"

BB_RUN_DIR="${BB_RUN_DIR:-/run/builderbot}"
# Under /config so a key survives the container being recreated; root-only,
# so the dashboard and every session reach it only through this script. A
# store named by the caller is the caller's own: the unit tests', which are
# nobody's root (sudo hands this script none of its caller's environment).
STORE="$(bb_root_state)/deploy-keys"   # /config in the container (R90)
if [ -n "${BB_DEPLOY_KEY_STORE:-}" ]; then
    STORE="$BB_DEPLOY_KEY_STORE"
else
    [ "$(id -u)" -eq 0 ] || die "must run as root (via sudo)"
fi
SOCK="$BB_RUN_DIR/ssh-agent.sock"
SEAL="$HERE/lib/sealfile.py"

kind="${1:-}"
name="${2:-}"
case "$kind" in
    make|store|forget)
        [[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,99}$ ]] \
            || die "usage: deploy-key $kind NAME (letters, digits, dot, dash, underscore)" ;;
    --list|--load|--reseal) ;;
    *) die "usage: deploy-key [make|store|forget] NAME, or --list, --load or --reseal" ;;
esac
install -d -m 0700 "$STORE"
file="$STORE/$name"

# The install key's file and the one before it, as boot left them for root
# (boot.sh install_key_file writes the two paths): empty where this install
# seals nothing.
KEY="" PREV=""
if [ -r "$BB_RUN_DIR/install-key.where" ]; then
    { IFS= read -r KEY; IFS= read -r PREV || true; } < "$BB_RUN_DIR/install-key.where"
fi
[ -n "$KEY" ] && [ -s "$KEY" ] || KEY=""
[ -n "$PREV" ] && [ -s "$PREV" ] || PREV=""
sealing() { [ -n "$KEY" ]; }
seal_to() {       # stdin, sealed, to $1, in place whole or not at all
    if python3 "$SEAL" seal "$KEY" ${PREV:+"$PREV"} > "$1.new" && chmod 0600 "$1.new" && mv -f "$1.new" "$1"; then
        return 0
    fi
    rm -f "$1.new"
    return 1
}
opened() { python3 "$SEAL" open "$KEY" ${PREV:+"$PREV"} < "$1"; }
gone() { if command -v shred >/dev/null 2>&1; then shred -u "$@" 2>/dev/null || rm -f "$@"; else rm -f "$@"; fi; }

# Into the agent, the comment being the key's name: the dashboard lists the
# agent's keys by comment (server.agent_keys), and ssh-add takes it from the
# key itself. A sealed key is opened into the agent and nowhere else.
agent() { [ -S "$SOCK" ] || die "the shielded ssh-agent is not running here (no ssh-agent or socat in the image?)"; }
load() {          # NAME
    agent
    if [ -f "$STORE/$1.sealed" ]; then
        sealing || die "$1 is sealed and this install's key is not here to open it"
        opened "$STORE/$1.sealed" | SSH_AUTH_SOCK="$SOCK" ssh-add - >/dev/null 2>&1 || die "the agent would not take $1"
    else
        SSH_AUTH_SOCK="$SOCK" ssh-add "$STORE/$1" >/dev/null 2>&1 || die "the agent would not take $1"
    fi
}
# A plain key file sealed in its place: NAME becomes NAME.sealed.
keep() {          # the plain file
    if sealing; then
        seal_to "$1.sealed" < "$1" || die "$(basename "$1") could not be sealed, and is not kept"
        gone "$1"
    else
        chmod 0600 "$1"
        warn "$(basename "$1") is kept as a plain key file: this install has no install key to seal it under"
    fi
}

case "$kind" in
    make)
        [ ! -e "$file" ] && [ ! -e "$file.sealed" ] || die "a deploy key called $name is kept already: forget it first"
        ssh-keygen -q -t ed25519 -N "" -C "$name" -f "$file" >/dev/null
        chmod 0600 "$file"
        keep "$file"
        load "$name"
        cat "$file.pub" ;;
    store)
        [ ! -e "$file" ] && [ ! -e "$file.sealed" ] || die "a deploy key called $name is kept already: forget it first"
        tmp="$(mktemp "$STORE/.in.XXXXXX")"
        trap 'rm -f "$tmp" "$tmp.pub"' EXIT
        head -c 16384 > "$tmp"
        chmod 0600 "$tmp"
        grep -q 'PRIVATE KEY' "$tmp" || die "that is not a private key: paste the whole file, BEGIN and END lines included"
        ssh-keygen -y -P "" -f "$tmp" > "$tmp.pub" 2>/dev/null \
            || die "that key cannot be read without a passphrase, or is not a key ssh reads"
        # Its comment set to the name, so the agent lists it by that name.
        ssh-keygen -q -c -C "$name" -P "" -f "$tmp" >/dev/null 2>&1 || true
        ssh-keygen -y -P "" -f "$tmp" | awk -v n="$name" '{print $1, $2, n}' > "$tmp.pub"
        mv "$tmp" "$file"; mv "$tmp.pub" "$file.pub"
        trap - EXIT
        keep "$file"
        load "$name"
        cat "$file.pub" ;;
    forget)
        [ -e "$file" ] || [ -e "$file.sealed" ] || die "no deploy key called $name is kept here"
        [ -S "$SOCK" ] && SSH_AUTH_SOCK="$SOCK" ssh-add -d "$file.pub" >/dev/null 2>&1 || true
        [ ! -e "$file" ] || gone "$file"
        rm -f "$file.sealed" "$file.pub"
        echo "forgot $name" ;;
    --list)
        for f in "$STORE"/*.pub; do
            [ -f "$f" ] || continue
            basename "$f" .pub
        done ;;
    --load)
        n=0
        # What is still a plain key file, from before keys were sealed.
        for f in "$STORE"/*; do
            [ -f "$f" ] || continue
            case "$f" in *.pub|*.sealed|*.new) continue ;; esac
            grep -q 'PRIVATE KEY' "$f" 2>/dev/null || continue
            if sealing && seal_to "$f.sealed" < "$f"; then
                gone "$f"
                log "deploy key $(basename "$f") is sealed under the install key now"
            elif [ -S "$SOCK" ] && SSH_AUTH_SOCK="$SOCK" ssh-add "$f" >/dev/null 2>&1; then
                n=$((n + 1))
                sealing && warn "deploy key $(basename "$f") could not be sealed and stays a plain key file"
            else
                warn "could not load deploy key $(basename "$f")"
            fi
        done >&2
        for f in "$STORE"/*.sealed; do
            [ -f "$f" ] || continue
            k="$(basename "$f" .sealed)"
            if sealing && [ -S "$SOCK" ] && opened "$f" 2>/dev/null | SSH_AUTH_SOCK="$SOCK" ssh-add - >/dev/null 2>&1; then
                n=$((n + 1))
            else
                warn "could not load deploy key $k$(sealing || echo ": it is sealed, and this install's key is not here to open it")" >&2
            fi
        done
        echo "$n" ;;
    --reseal)
        sealing || die "this install has no install key to seal under"
        n=0 bad=0
        for f in "$STORE"/*.sealed; do
            [ -f "$f" ] || continue
            python3 "$SEAL" current "$KEY" < "$f" && continue
            if opened "$f" 2>/dev/null | seal_to "$f"; then
                n=$((n + 1))
            else
                bad=$((bad + 1))
                warn "deploy key $(basename "$f" .sealed) could not be opened to seal it again" >&2
            fi
        done
        echo "$n"
        [ "$bad" -eq 0 ] ;;
esac
